<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BlackBox.App.ViewModels"
             x:Class="BlackBox.App.Views.DiffPanel"
             x:DataType="vm:DiffViewModel"
             Background="{StaticResource BbBackground}">

  <UserControl.Styles>
    <!-- The diff's rows: no look of a list item's own, but for the line's colour and the pick's. -->
    <Style Selector="ListBox.diff">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ListBox.diff ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="ListBox.diff ListBoxItem /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.diff ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.diff ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.diff ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.diff ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.row.added">
      <Setter Property="Background" Value="#1D3527" />
    </Style>
    <Style Selector="Border.row.removed">
      <Setter Property="Background" Value="#3A2125" />
    </Style>
    <Style Selector="Border.row.hunk">
      <Setter Property="Background" Value="{StaticResource BbSurface}" />
    </Style>
    <Style Selector="Border.row.header">
      <Setter Property="Background" Value="{StaticResource BbSurfaceRaised}" />
      <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
    <Style Selector="ListBox.diff ListBoxItem:pointerover Border.row">
      <Setter Property="BorderBrush" Value="#80E0A64B" />
    </Style>
    <!-- Picked: goes with the next message. -->
    <Style Selector="ListBox.diff ListBoxItem:selected Border.row">
      <Setter Property="Background" Value="#5A6A4A1E" />
      <Setter Property="BorderBrush" Value="{StaticResource BbAccent}" />
    </Style>
    <Style Selector="TextBlock.number">
      <Setter Property="Foreground" Value="{StaticResource BbMuted}" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="TextBlock.marker.added">
      <Setter Property="Foreground" Value="{StaticResource BbOk}" />
    </Style>
    <Style Selector="TextBlock.marker.removed">
      <Setter Property="Foreground" Value="{StaticResource BbError}" />
    </Style>
    <Style Selector="TextBlock.hunkText">
      <Setter Property="Foreground" Value="{StaticResource BbMuted}" />
    </Style>
    <Style Selector="ListBox.files">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.files ListBoxItem">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="TextBlock.added">
      <Setter Property="Foreground" Value="{StaticResource BbOk}" />
    </Style>
    <Style Selector="TextBlock.deleted">
      <Setter Property="Foreground" Value="{StaticResource BbError}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- The repository (its name opens the folders' menu), what is compared, and Refresh. -->
    <Border DockPanel.Dock="Top" Background="{StaticResource BbSurface}" BorderBrush="{StaticResource BbBorder}" BorderThickness="0,0,0,1" Padding="12,8">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="ghost" Padding="8,4" Command="{Binding RefreshCommand}" VerticalAlignment="Center"
                ToolTip.Tip="Read the changes again (they also show by themselves as files change)" AutomationProperties.Name="Refresh">
          <PathIcon Width="14" Height="14" Data="M17.65 6.35A7.96 7.96 0 0 0 12 4a8 8 0 1 0 7.74 10h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
        </Button>
        <Button x:Name="FolderButton" DockPanel.Dock="Left" Classes="ghost" Padding="8,4" Margin="0,0,12,0" Click="OnFolderMenu"
                ToolTip.Tip="{Binding Folder, FallbackValue='Choose a folder with a git repository'}" AutomationProperties.Name="Repository">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding FolderName}" FontWeight="SemiBold" MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <PathIcon Data="M7 10l5 5 5-5z" Width="10" Height="10" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" Width="210" AutomationProperties.Name="Compare">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DiffMode">
                <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Tip}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBox x:Name="RefBox" Text="{Binding Ref}" IsVisible="{Binding TakesRef}" Width="170" Watermark="main, HEAD~3, a1b2c3d"
                   KeyDown="OnRefKeyDown" AutomationProperties.Name="Commit or branch" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- What the panel did or what went wrong, else how it is used; what was compared on the right. -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BbBorder}" BorderThickness="0,0,0,1" Padding="12,6">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding Summary}" Margin="12,0,0,0" VerticalAlignment="Center" />
        <TextBlock Classes="muted" Text="{Binding StatusOrHint}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding StatusOrHint}" />
      </DockPanel>
    </Border>

    <!-- A commit's hash, author, date and message. -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding HasCommitNote}" Background="{StaticResource BbSurface}" BorderBrush="{StaticResource BbBorder}" BorderThickness="0,0,0,1" Padding="12,8">
      <ScrollViewer MaxHeight="110">
        <SelectableTextBlock Text="{Binding CommitNote}" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" />
      </ScrollViewer>
    </Border>

    <Grid ColumnDefinitions="230,4,*">
      <!-- The changed files: a click goes to one in the diff. -->
      <ListBox x:Name="FileList" Grid.Column="0" Classes="files" ItemsSource="{Binding Files}" SelectionChanged="OnFilePicked" AutomationProperties.Name="Changed files">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:DiffFileItem">
            <StackPanel Spacing="1" ToolTip.Tip="{Binding Name}">
              <TextBlock Text="{Binding Name}" TextTrimming="LeadingCharacterEllipsis" Classes.added="{Binding IsNew}" Classes.deleted="{Binding IsDeleted}" />
              <TextBlock Classes="muted" FontSize="11">
                <Run Text="{Binding Status}" /><Run Text=" · " /><Run Text="{Binding Counts}" />
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <GridSplitter Grid.Column="1" Background="{StaticResource BbBorder}" ResizeDirection="Columns" />

      <Panel Grid.Column="2">
        <TextBlock Classes="muted" IsVisible="{Binding !HasFiles}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"
                   Text="{Binding EmptyText}" />
        <!-- Every row of the diff; clicked lines are picked into the chat's box. -->
        <ListBox x:Name="DiffList" Classes="diff" ItemsSource="{Binding Rows}" Selection="{Binding Selection}" SelectionMode="Multiple"
                 IsVisible="{Binding HasFiles}" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Diff">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:DiffRow">
              <Border Classes="row" Classes.added="{Binding IsAdded}" Classes.removed="{Binding IsRemoved}" Classes.hunk="{Binding IsHunk}" Classes.header="{Binding IsHeader}">
                <Panel>
                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,5" IsVisible="{Binding IsHeader}">
                    <TextBlock Text="{Binding Text}" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="{Binding HeaderDetails}" Classes="muted" VerticalAlignment="Center" />
                  </StackPanel>
                  <Grid ColumnDefinitions="46,46,16,Auto" IsVisible="{Binding !IsHeader}" Margin="0,1" TextElement.FontFamily="Cascadia Mono,Consolas,monospace">
                    <TextBlock Grid.Column="0" Classes="number" Text="{Binding OldNumber}" />
                    <TextBlock Grid.Column="1" Classes="number" Text="{Binding NewNumber}" />
                    <TextBlock Grid.Column="2" Classes="marker" Classes.added="{Binding IsAdded}" Classes.removed="{Binding IsRemoved}" Text="{Binding Marker}" />
                    <TextBlock Grid.Column="3" Text="{Binding Text}" Classes.hunkText="{Binding IsHunk}" TextWrapping="NoWrap" Margin="0,0,16,0" />
                  </Grid>
                </Panel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Panel>
    </Grid>
  </DockPanel>
</UserControl>
