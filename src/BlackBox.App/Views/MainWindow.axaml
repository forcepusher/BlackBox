<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BlackBox.App.ViewModels"
        x:Class="BlackBox.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="BlackBox"
        Icon="/Assets/blackbox.ico"
        Width="900" Height="760" MinWidth="660" MinHeight="480"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

    <!-- Header -->
    <Border Grid.Row="0" Background="{StaticResource BbSurface}" BorderBrush="{StaticResource BbBorder}" BorderThickness="0,0,0,1" Padding="14,8">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Image Source="/Assets/blackbox.png" Width="22" Height="22" RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="BlackBox" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
            <Ellipse Classes="status" Classes.checking="{Binding IsChecking}" Classes.connected="{Binding IsConnected}" Classes.failed="{Binding IsFailed}"
                     Width="9" Height="9" VerticalAlignment="Center" />
            <TextBlock Classes="muted" Text="{Binding ServerStatusText}" VerticalAlignment="Center" />
            <TextBlock Classes="muted" Text="{Binding ContextUsage, StringFormat='· {0}'}" IsVisible="{Binding HasContextUsage}"
                       ToolTip.Tip="{Binding ContextUsageTip}" VerticalAlignment="Center" />
          </StackPanel>
          <!-- Earlier chats, newest first: a row opens one, its trash button deletes it. -->
          <Button x:Name="HistoryButton" Classes="ghost" ToolTip.Tip="Earlier chats" AutomationProperties.Name="History">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="History" VerticalAlignment="Center" />
              <PathIcon Width="10" Height="10" VerticalAlignment="Center" Data="M7 10l5 5 5-5z" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="history">
                <Panel Width="340">
                  <TextBlock Classes="muted" IsVisible="{Binding !HasPastChats}" TextWrapping="Wrap" Margin="10,8"
                             Text="No chats yet. Every chat is kept here from its first message on." />
                  <ItemsControl ItemsSource="{Binding PastChats}" IsVisible="{Binding HasPastChats}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PastChat">
                        <Border Classes="pastChat" Classes.current="{Binding IsCurrent}">
                          <Grid ColumnDefinitions="*,Auto">
                            <Button Grid.ColumnSpan="2" Classes="pastChat" Command="{Binding OpenCommand}" Click="OnPastChatClick" AutomationProperties.Name="{Binding Title}">
                              <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="muted" Text="{Binding When}" />
                              </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Classes="deleteChat" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete this chat" AutomationProperties.Name="Delete chat">
                              <PathIcon Width="16" Height="16" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM8 9h8v10H8V9zm7.5-5l-1-1h-5l-1 1H5v2h14V4h-3.5z" />
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Panel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Classes="ghost" Content="New chat" Command="{Binding NewChatCommand}" />
          <Button Classes="ghost" Content="Settings" Click="OnSettingsClick" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- What the agent talks to: server and key, then model and how much context to use.
         The labels share a column so both rows line up, and both rows are exactly as tall as a text
         box so every field and button in a row shares its top and bottom edges. -->
    <Border Grid.Row="1" Background="{StaticResource BbSurface}" BorderBrush="{StaticResource BbBorder}" BorderThickness="0,0,0,1" Padding="14,8">
      <Grid ColumnDefinitions="Auto,3*,Auto,2*,Auto" RowDefinitions="32,32" RowSpacing="8" VerticalAlignment="Center">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="muted" Text="Server" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ServerAddress}" Watermark="http://localhost:1234/v1" MinWidth="270" />
        <TextBlock Grid.Row="0" Grid.Column="2" Classes="muted" Text="API key" VerticalAlignment="Center" Margin="14,0,8,0" />
        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding ApiKey}" PasswordChar="•" RevealPassword="{Binding ShowApiKey}" MinWidth="120"
                 Watermark="Optional"
                 ToolTip.Tip="Sent to the server with every request. Saved in plain text in the Data folder next to BlackBox, so keep that folder private." />
        <ToggleButton Grid.Row="0" Grid.Column="4" Classes="ghost" IsChecked="{Binding ShowApiKey}" Margin="6,0,0,0" Padding="8,6"
                      VerticalAlignment="Stretch" ToolTip.Tip="Show or hide the API key" AutomationProperties.Name="Show API key">
          <Panel>
            <PathIcon Width="16" Height="16" IsVisible="{Binding !ShowApiKey}"
                      Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" />
            <PathIcon Width="16" Height="16" IsVisible="{Binding ShowApiKey}"
                      Data="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z" />
          </Panel>
        </ToggleButton>

        <TextBlock Grid.Row="1" Grid.Column="0" Classes="muted" Text="Model" VerticalAlignment="Center" Margin="0,0,8,0" />
        <DockPanel Grid.Row="1" Grid.Column="1">
          <Button DockPanel.Dock="Right" Classes="ghost" Content="↻" Margin="6,0,0,0" VerticalAlignment="Stretch" Command="{Binding CheckServerCommand}"
                  ToolTip.Tip="Ask the server again for its models and context size" />
          <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    PlaceholderText="No models: check the server address" />
        </DockPanel>
        <TextBlock Grid.Row="1" Grid.Column="2" Classes="muted" Text="Context" VerticalAlignment="Center" Margin="14,0,8,0" />
        <DockPanel Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" ToolTip.Tip="{Binding ContextToolTip}">
          <CheckBox DockPanel.Dock="Right" Content="Auto" IsChecked="{Binding AutoContext}" Margin="10,0,0,0" MinWidth="0" />
          <TextBox x:Name="ContextBox" DockPanel.Dock="Right" Text="{Binding ContextInput, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding !AutoContext}"
                   Width="90" Padding="6,5" TextAlignment="Right" VerticalAlignment="Stretch" VerticalContentAlignment="Center" />
          <!-- Fluent's slider is 50px tall with the track in its middle: stretched over the 32px row
               plus these margins, the track sits on the row's centre line. -->
          <Slider Minimum="0" Maximum="{Binding ContextMaxIndex}" Value="{Binding ContextIndex}" TickFrequency="1" IsSnapToTickEnabled="True"
                  IsEnabled="{Binding !AutoContext}" VerticalAlignment="Stretch" Margin="0,-9,6,-9" MinWidth="60" />
        </DockPanel>
      </Grid>
    </Border>

    <!-- Not connected yet: what to do about it -->
    <Border Grid.Row="2" IsVisible="{Binding ShowSetupBanner}" Background="{StaticResource BbSurfaceRaised}"
            BorderBrush="{StaticResource BbAccent}" BorderThickness="0,0,0,2" Padding="16,12">
      <Grid ColumnDefinitions="*,Auto" MaxWidth="860">
        <StackPanel Spacing="6">
          <TextBlock Text="BlackBox isn't connected to a model yet" FontWeight="SemiBold" />
          <TextBlock Classes="muted" Text="{Binding SetupText}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Classes="ghost" Content="Check again" Command="{Binding CheckServerCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Conversation -->
    <Panel Grid.Row="3">
      <StackPanel IsVisible="{Binding HasNoMessages}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="460">
        <Image Source="/Assets/blackbox.png" Width="48" Height="48" Opacity="0.8" RenderOptions.BitmapInterpolationMode="HighQuality" />
        <TextBlock Text="What should I do on your computer?" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                   Text="I can look at the screen, use the mouse and keyboard, run commands and work with files. To halt me at any time, press Stop or the Break (Pause) key." />
      </StackPanel>

      <!-- Spacing lives on the ItemsControl as a margin, not as ScrollViewer padding:
           padding is not part of the scroll extent, so the last lines ended up clipped. -->
      <ScrollViewer x:Name="ChatScroll" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Items}" MaxWidth="860" Margin="16,12,16,16">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.DataTemplates>

            <DataTemplate DataType="vm:UserMessageItem">
              <Border Background="{StaticResource BbUserBubble}" CornerRadius="10" Padding="12,8"
                      HorizontalAlignment="Right" MaxWidth="640" Margin="60,0,0,0">
                <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
              </Border>
            </DataTemplate>

            <DataTemplate DataType="vm:AssistantMessageItem">
              <StackPanel Spacing="6" Margin="0,0,40,0">
                <Expander IsVisible="{Binding HasReasoning}" Header="{Binding ThinkingLabel}" HorizontalAlignment="Stretch" IsExpanded="True"
                          Padding="10,6">
                  <SelectableTextBlock Classes="muted" Text="{Binding ShownReasoning}" TextWrapping="Wrap" />
                </Expander>
                <SelectableTextBlock Text="{Binding ShownText}" TextWrapping="Wrap" IsVisible="{Binding HasText}" LineHeight="21" />
                <TextBlock Classes="muted" Text="{Binding TypingText}" IsVisible="{Binding ShowTypingDots}" />
              </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="vm:ToolCallItem">
              <Border Classes="card" Margin="0,0,40,0">
                <StackPanel Spacing="6">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding StatusText}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Background="{StaticResource BbSurfaceRaised}" CornerRadius="4" Padding="6,1">
                        <TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" Foreground="{StaticResource BbAccent}" />
                      </Border>
                      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                  </DockPanel>

                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAwaitingApproval}">
                    <Button Classes="primary" Content="Allow" Command="{Binding ApproveCommand}" />
                    <Button Classes="ghost" Content="Deny" Command="{Binding DenyCommand}" />
                  </StackPanel>

                  <Image Source="{Binding Screenshot}" IsVisible="{Binding HasScreenshot}" MaxWidth="480"
                         HorizontalAlignment="Left" Stretch="Uniform" />

                  <Expander IsVisible="{Binding HasResult}" Header="Output" Padding="8,4" HorizontalAlignment="Stretch">
                    <SelectableTextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" />
                  </Expander>
                </StackPanel>
              </Border>
            </DataTemplate>

            <DataTemplate DataType="vm:NoticeItem">
              <Border Padding="10,6" CornerRadius="6" Background="{StaticResource BbSurface}" HorizontalAlignment="Center">
                <SelectableTextBlock Classes="muted" Classes.error="{Binding IsError}" Text="{Binding Text}" TextWrapping="Wrap" />
              </Border>
            </DataTemplate>

          </ItemsControl.DataTemplates>
        </ItemsControl>
      </ScrollViewer>
    </Panel>

    <!-- Input -->
    <Border Grid.Row="4" Padding="16,8,16,14">
      <!-- One line of text is exactly as tall as the Send button, and both sit on the same
           bottom edge, so they line up; longer text grows the box upwards with Send staying put. -->
      <Border Classes="card composer" MaxWidth="860" Padding="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBox x:Name="InputBox" Grid.Column="0" Classes="composer" Text="{Binding Input}" AcceptsReturn="True" TextWrapping="Wrap"
                   MaxHeight="200" VerticalContentAlignment="Center"
                   Watermark="Describe a task… (Enter to send, Shift+Enter for a new line)" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom" Margin="8,0,0,0">
            <Button Classes="primary" Content="Send" Command="{Binding SendCommand}" IsVisible="{Binding !IsBusy}" MinHeight="32" />
            <Button Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding IsBusy}" Background="{StaticResource BbError}" MinHeight="32" />
          </StackPanel>
        </Grid>
      </Border>
    </Border>
  </Grid>
</Window>
