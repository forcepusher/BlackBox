<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BlackBox.App.ViewModels"
        xmlns:views="using:BlackBox.App.Views"
        x:Class="BlackBox.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="BlackBox"
        Icon="/Assets/blackbox.ico"
        Width="900" Height="760" MinWidth="660" MinHeight="480"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <!-- The intro in an unused chat: the cards on what BlackBox can do, and Esc drawn as a key. -->
    <Style Selector="StackPanel.conversation.unused">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="PathIcon.capability">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,1,10,0" />
      <Setter Property="Foreground" Value="{StaticResource BbAccent}" />
    </Style>
    <Style Selector="TextBlock.capability">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted.warning">
      <Setter Property="Foreground" Value="{StaticResource BbAccent}" />
    </Style>
    <Style Selector="Border.key">
      <Setter Property="Background" Value="{StaticResource BbSurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{StaticResource BbMuted}" />
      <Setter Property="BorderThickness" Value="1,1,1,2" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.key > TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Previews of files under a tool call or a reply. -->
    <Style Selector="Border.preview">
      <Setter Property="Background" Value="{StaticResource BbSurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{StaticResource BbBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="MaxWidth" Value="498" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.picture">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.picture /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.bigPlay">
      <Setter Property="Width" Value="56" />
      <Setter Property="Height" Value="56" />
      <Setter Property="CornerRadius" Value="28" />
      <Setter Property="Background" Value="#B0000000" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.roundPlay">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{StaticResource BbAccent}" />
      <Setter Property="Foreground" Value="#111214" />
    </Style>
    <!-- Files going with a message: thumbnails of pictures, and the name of anything else. -->
    <Style Selector="Border.attachment">
      <Setter Property="Background" Value="{StaticResource BbSurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{StaticResource BbBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.attachment.file">
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style Selector="Border.attachment PathIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Foreground" Value="{StaticResource BbAccent}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.removeAttachment">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,-6,-6,0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#E0111214" />
      <Setter Property="BorderBrush" Value="{StaticResource BbMuted}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.removeAttachment PathIcon">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.removeAttachment:pointerover PathIcon">
      <Setter Property="Foreground" Value="{StaticResource BbError}" />
    </Style>
  </Window.Styles>

  <!-- How each kind of file is previewed: under the tool call that made or showed it, and under a
       reply that names it by its path. -->
  <Window.DataTemplates>
    <DataTemplate DataType="vm:ImagePreview">
      <Border Classes="preview">
        <StackPanel Spacing="8">
          <Button Classes="picture" Command="{Binding OpenCommand}" ToolTip.Tip="Open it" HorizontalAlignment="Left">
            <Image Source="{Binding Image}" MaxWidth="480" MaxHeight="480" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="MediumQuality" />
          </Button>
          <views:PreviewFooter />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="vm:AnimationPreview">
      <Border Classes="preview">
        <StackPanel Spacing="8">
          <Button Classes="picture" Command="{Binding OpenCommand}" ToolTip.Tip="Open it" HorizontalAlignment="Left">
            <Image Source="{Binding Image}" MaxWidth="480" MaxHeight="480" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="MediumQuality" />
          </Button>
          <views:PreviewFooter />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="vm:VideoPreview">
      <Border Classes="preview">
        <StackPanel Spacing="6">
          <Panel HorizontalAlignment="Left" MaxWidth="480">
            <Button Classes="picture" Command="{Binding PlayCommand}" ToolTip.Tip="Play or pause" AutomationProperties.Name="Play or pause video">
              <Image Source="{Binding Frame}" MaxWidth="480" MaxHeight="480" MinHeight="120" MinWidth="200" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="MediumQuality" />
            </Button>
            <Button Classes="bigPlay" Command="{Binding PlayCommand}" IsVisible="{Binding !IsPlaying}" ToolTip.Tip="Play" AutomationProperties.Name="Play video">
              <PathIcon Data="M8 5v14l11-7z" Width="24" Height="24" Foreground="White" />
            </Button>
          </Panel>
          <DockPanel>
            <Button DockPanel.Dock="Left" Classes="ghost" Padding="8,4" Command="{Binding PlayCommand}" VerticalAlignment="Center" ToolTip.Tip="Play or pause" AutomationProperties.Name="Play or pause">
              <PathIcon Data="{Binding PlayIcon}" Width="12" Height="12" />
            </Button>
            <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding TimeText}" VerticalAlignment="Center" Margin="8,0,0,0" />
            <Slider Minimum="0" Maximum="{Binding Length}" Value="{Binding Position}" Margin="8,-8,0,-8" VerticalAlignment="Center" />
          </DockPanel>
          <views:PreviewFooter />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="vm:AudioPreview">
      <Border Classes="preview" Width="498">
        <StackPanel Spacing="6">
          <DockPanel>
            <Button DockPanel.Dock="Left" Classes="roundPlay" Command="{Binding PlayCommand}" VerticalAlignment="Center" ToolTip.Tip="Play or pause" AutomationProperties.Name="Play or pause sound">
              <PathIcon Data="{Binding PlayIcon}" Width="14" Height="14" Foreground="#111214" />
            </Button>
            <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding TimeText}" VerticalAlignment="Center" Margin="8,0,0,0" />
            <Panel Height="56" Margin="10,0,0,0">
              <Image Source="{Binding Waveform}" Stretch="Fill" RenderOptions.BitmapInterpolationMode="MediumQuality" />
              <Slider Minimum="0" Maximum="{Binding Length}" Value="{Binding Position}" VerticalAlignment="Center" Opacity="0.85" />
            </Panel>
          </DockPanel>
          <views:PreviewFooter />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="vm:ModelPreview">
      <Border Classes="preview">
        <StackPanel Spacing="6">
          <views:ModelViewer Mesh="{Binding Mesh}" Width="480" Height="360" HorizontalAlignment="Left" ToolTip.Tip="Drag to turn it, scroll to come closer, double-click to see it as at first" />
          <views:PreviewFooter />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="vm:FileCardPreview">
      <Border Classes="preview" Width="498">
        <DockPanel>
          <PathIcon DockPanel.Dock="Left" Width="22" Height="22" Margin="2,0,10,0" Foreground="{StaticResource BbAccent}" VerticalAlignment="Center"
                    Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" />
          <views:PreviewFooter />
        </DockPanel>
      </Border>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

    <!-- Header -->
    <Border Grid.Row="0" Background="{StaticResource BbSurface}" BorderBrush="{StaticResource BbBorder}" BorderThickness="0,0,0,1" Padding="14,8">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Image Source="/Assets/blackbox.png" Width="22" Height="22" RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="BlackBox" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
            <Ellipse Classes="status" Classes.checking="{Binding IsChecking}" Classes.connected="{Binding IsConnected}" Classes.failed="{Binding IsFailed}"
                     Width="9" Height="9" VerticalAlignment="Center" />
            <TextBlock Classes="muted" Text="{Binding ServerStatusText}" VerticalAlignment="Center" />
            <TextBlock Classes="muted" Text="{Binding ContextUsage, StringFormat='· {0}'}" IsVisible="{Binding HasContextUsage}"
                       ToolTip.Tip="{Binding ContextUsageTip}" VerticalAlignment="Center" />
          </StackPanel>
          <!-- Earlier chats, newest first: a row opens one, its trash button deletes it. -->
          <Button x:Name="HistoryButton" Classes="ghost" ToolTip.Tip="Earlier chats" AutomationProperties.Name="History">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="History" VerticalAlignment="Center" />
              <PathIcon Width="10" Height="10" VerticalAlignment="Center" Data="M7 10l5 5 5-5z" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="history">
                <Panel Width="340">
                  <TextBlock Classes="muted" IsVisible="{Binding !HasPastChats}" TextWrapping="Wrap" Margin="10,8"
                             Text="No chats yet. Every chat is kept here from its first message on." />
                  <ItemsControl ItemsSource="{Binding PastChats}" IsVisible="{Binding HasPastChats}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PastChat">
                        <Border Classes="pastChat" Classes.current="{Binding IsCurrent}">
                          <Grid ColumnDefinitions="*,Auto">
                            <Button Grid.ColumnSpan="2" Classes="pastChat" Command="{Binding OpenCommand}" Click="OnPastChatClick" AutomationProperties.Name="{Binding Title}">
                              <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="muted" Text="{Binding When}" />
                              </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Classes="deleteChat" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete this chat" AutomationProperties.Name="Delete chat">
                              <PathIcon Width="16" Height="16" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM8 9h8v10H8V9zm7.5-5l-1-1h-5l-1 1H5v2h14V4h-3.5z" />
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Panel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Classes="ghost" Content="New chat" Command="{Binding NewChatCommand}" />
          <Button Classes="ghost" Content="Settings" Click="OnSettingsClick" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- What the agent talks to: server and key, then model and how much context to use.
         The labels share a column so both rows line up, and both rows are exactly as tall as a text
         box so every field and button in a row shares its top and bottom edges. -->
    <Border Grid.Row="1" Background="{StaticResource BbSurface}" BorderBrush="{StaticResource BbBorder}" BorderThickness="0,0,0,1" Padding="14,8">
      <Grid ColumnDefinitions="Auto,3*,Auto,2*,Auto" RowDefinitions="32,32" RowSpacing="8" VerticalAlignment="Center">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="muted" Text="Server" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ServerAddress}" Watermark="http://localhost:1234/v1" MinWidth="270" />
        <TextBlock Grid.Row="0" Grid.Column="2" Classes="muted" Text="API key" VerticalAlignment="Center" Margin="14,0,8,0" />
        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding ApiKey}" PasswordChar="•" RevealPassword="{Binding ShowApiKey}" MinWidth="120"
                 Watermark="Optional"
                 ToolTip.Tip="Sent to the server with every request. Saved in plain text in the Data folder next to BlackBox, so keep that folder private." />
        <ToggleButton Grid.Row="0" Grid.Column="4" Classes="ghost" IsChecked="{Binding ShowApiKey}" Margin="6,0,0,0" Padding="8,6"
                      VerticalAlignment="Stretch" ToolTip.Tip="Show or hide the API key" AutomationProperties.Name="Show API key">
          <Panel>
            <PathIcon Width="16" Height="16" IsVisible="{Binding !ShowApiKey}"
                      Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" />
            <PathIcon Width="16" Height="16" IsVisible="{Binding ShowApiKey}"
                      Data="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z" />
          </Panel>
        </ToggleButton>

        <TextBlock Grid.Row="1" Grid.Column="0" Classes="muted" Text="Model" VerticalAlignment="Center" Margin="0,0,8,0" />
        <DockPanel Grid.Row="1" Grid.Column="1">
          <Button DockPanel.Dock="Right" Classes="ghost" Content="↻" Margin="6,0,0,0" VerticalAlignment="Stretch" Command="{Binding CheckServerCommand}"
                  ToolTip.Tip="Ask the server again for its models and context size" />
          <ComboBox x:Name="ModelBox" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    PlaceholderText="No models: check the server address" ToolTip.Tip="{Binding ModelToolTip}" />
        </DockPanel>
        <TextBlock Grid.Row="1" Grid.Column="2" Classes="muted" Text="Context" VerticalAlignment="Center" Margin="14,0,8,0" />
        <DockPanel Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" ToolTip.Tip="{Binding ContextToolTip}">
          <CheckBox DockPanel.Dock="Right" Content="Auto" IsChecked="{Binding AutoContext}" Margin="10,0,0,0" MinWidth="0" />
          <TextBox x:Name="ContextBox" DockPanel.Dock="Right" Text="{Binding ContextInput, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding !AutoContext}"
                   Width="90" Padding="6,5" TextAlignment="Right" VerticalAlignment="Stretch" VerticalContentAlignment="Center" />
          <!-- Fluent's slider is 50px tall with the track in its middle: stretched over the 32px row
               plus these margins, the track sits on the row's centre line. -->
          <Slider Minimum="0" Maximum="{Binding ContextMaxIndex}" Value="{Binding ContextIndex}" TickFrequency="1" IsSnapToTickEnabled="True"
                  IsEnabled="{Binding !AutoContext}" VerticalAlignment="Stretch" Margin="0,-9,6,-9" MinWidth="60" />
        </DockPanel>
      </Grid>
    </Border>

    <!-- Not connected yet, or the picked model isn't on the server: what to do about it -->
    <Border Grid.Row="2" IsVisible="{Binding ShowSetupBanner}" Background="{StaticResource BbSurfaceRaised}"
            BorderBrush="{StaticResource BbAccent}" BorderThickness="0,0,0,2" Padding="16,12">
      <Grid ColumnDefinitions="*,Auto" MaxWidth="860">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding SetupTitle}" FontWeight="SemiBold" />
          <TextBlock Classes="muted" Text="{Binding SetupText}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Classes="ghost" Content="Check again" Command="{Binding CheckServerCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Conversation. Until the chat is used, the intro sits under whatever notices came up (an MCP
         server that failed to start), the two in the middle of the window, or read from the top
         when they don't fit. Spacing lives on the content as a margin, not as ScrollViewer padding:
         padding is not part of the scroll extent, so the last lines ended up clipped. -->
    <ScrollViewer x:Name="ChatScroll" Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Classes="conversation" Classes.unused="{Binding ShowIntro}" MaxWidth="860" Margin="16,12,16,16" Spacing="10">
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.DataTemplates>

            <DataTemplate DataType="vm:UserMessageItem">
              <Border Background="{StaticResource BbUserBubble}" CornerRadius="10" Padding="12,8"
                      HorizontalAlignment="Right" MaxWidth="640" Margin="60,0,0,0">
                <StackPanel Spacing="6">
                  <!-- The files that came with it: a picture as itself, anything else by its name; a click opens it. -->
                  <ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Right" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AttachmentItem">
                        <Button Classes="picture" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding Tip}" Margin="0,0,0,6"
                                AutomationProperties.Name="{Binding FileName}">
                          <Panel Margin="6,0,0,0">
                            <Border Classes="attachment" IsVisible="{Binding !ShowsName}">
                              <Image Source="{Binding Thumbnail}" MaxHeight="180" MaxWidth="300" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="MediumQuality" />
                            </Border>
                            <Border Classes="attachment file" IsVisible="{Binding ShowsName}">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{Binding Icon}" />
                                <StackPanel Spacing="1">
                                  <TextBlock Text="{Binding FileName}" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Classes="muted" Text="{Binding Details}" />
                                </StackPanel>
                              </StackPanel>
                            </Border>
                          </Panel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding HasText}" />
                </StackPanel>
              </Border>
            </DataTemplate>

            <DataTemplate DataType="vm:AssistantMessageItem">
              <StackPanel Spacing="6" Margin="0,0,40,0">
                <Expander IsVisible="{Binding HasReasoning}" Header="{Binding ThinkingLabel}" HorizontalAlignment="Stretch" IsExpanded="True"
                          Padding="10,6">
                  <SelectableTextBlock Classes="muted" Text="{Binding ShownReasoning}" TextWrapping="Wrap" />
                </Expander>
                <SelectableTextBlock views:MarkdownText.Source="{Binding ShownText}" TextWrapping="Wrap" IsVisible="{Binding HasText}" LineHeight="21" />
                <TextBlock Classes="muted" Text="{Binding TypingText}" IsVisible="{Binding ShowTypingDots}" />
                <ItemsControl ItemsSource="{Binding Previews}" IsVisible="{Binding HasPreviews}" Margin="0,4,0,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="vm:ToolCallItem">
              <Border Classes="card" Margin="0,0,40,0">
                <StackPanel Spacing="6">
                  <!-- The summary takes the width that is left, so a long command wraps inside the card
                       (in a horizontal StackPanel it had all the width it wanted and ran past the
                       card's edge); past three lines it ends in "…", the whole of it in the tooltip. -->
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding StatusText}" VerticalAlignment="Top" Margin="8,0,0,0" />
                    <Border DockPanel.Dock="Left" Background="{StaticResource BbSurfaceRaised}" CornerRadius="4" Padding="6,1" VerticalAlignment="Top" Margin="0,0,8,0">
                      <TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" Foreground="{StaticResource BbAccent}" />
                    </Border>
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" ToolTip.Tip="{Binding Summary}" />
                  </DockPanel>

                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAwaitingApproval}">
                    <Button Classes="primary" Content="Allow" Command="{Binding ApproveCommand}" />
                    <Button Classes="ghost" Content="Deny" Command="{Binding DenyCommand}" />
                  </StackPanel>

                  <Image Source="{Binding Screenshot}" IsVisible="{Binding HasScreenshot}" MaxWidth="480"
                         HorizontalAlignment="Left" Stretch="Uniform" />

                  <ItemsControl ItemsSource="{Binding Previews}" IsVisible="{Binding HasPreviews}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>

                  <Expander IsVisible="{Binding HasResult}" Header="Output" Padding="8,4" HorizontalAlignment="Stretch">
                    <SelectableTextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" />
                  </Expander>
                </StackPanel>
              </Border>
            </DataTemplate>

            <DataTemplate DataType="vm:NoticeItem">
              <Border Padding="10,6" CornerRadius="6" Background="{StaticResource BbSurface}" HorizontalAlignment="Center">
                <SelectableTextBlock Classes="muted" Classes.error="{Binding IsError}" Text="{Binding Text}" TextWrapping="Wrap" />
              </Border>
            </DataTemplate>

          </ItemsControl.DataTemplates>
        </ItemsControl>

        <!-- What BlackBox can do and how to stop it, until the chat is used -->
        <StackPanel IsVisible="{Binding ShowIntro}" MaxWidth="640" Spacing="14">
          <StackPanel Spacing="6">
            <Image Source="/Assets/blackbox.png" Width="40" Height="40" Opacity="0.8" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="What should I do on your computer?" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460"
                       Text="Describe a task in your own words, and I'll work on it until it's done." />
          </StackPanel>

          <!-- How to stop it comes first: it is what someone needs once BlackBox has the mouse. -->
          <Border Classes="card">
            <StackPanel Spacing="6">
              <DockPanel>
                <Border Classes="key" Margin="0,0,8,0">
                  <TextBlock Text="Esc" />
                </Border>
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="stops me at any time, whatever window is in front. So does the Stop button." />
              </DockPanel>
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="While I work I use your mouse and keyboard, so leave them to me. To change or add to the task meanwhile, write it here and press Enter: I read it at my next step. My clicks and key presses pause while you type; click Resume, or stop typing for 15 seconds, to let me carry on without sending." />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding ApprovalNote}" />
            </StackPanel>
          </Border>

          <!-- Files and pictures go with a message: said where it is seen, as it isn't obvious in a chat box. -->
          <Border Classes="card">
            <DockPanel>
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4" Margin="0,0,8,0" VerticalAlignment="Top">
                <Border Classes="key">
                  <TextBlock Text="Ctrl" />
                </Border>
                <Border Classes="key">
                  <TextBlock Text="V" />
                </Border>
              </StackPanel>
              <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                         Text="in the box below pastes a screenshot, a copied picture or files from Explorer into your message. You can also drag files and pictures onto this window, or pick them with the paperclip. I see the pictures and work with the files." />
            </DockPanel>
          </Border>

          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
            <Border Grid.Row="0" Grid.Column="0" Classes="card">
              <DockPanel>
                <PathIcon Classes="capability" Data="M13 1.07V9h7c0-4.08-3.05-7.44-7-7.93zM4 15c0 4.42 3.58 8 8 8s8-3.58 8-8v-4H4v4zm7-13.93C7.05 1.56 4 4.92 4 9h7V1.07z" />
                <StackPanel Spacing="3">
                  <TextBlock Classes="capability" Text="Use any app" />
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="I see the screen and use the mouse and keyboard, in any program." />
                  <TextBlock Classes="muted warning" TextWrapping="Wrap" IsVisible="{Binding !CanSeeScreen}"
                             Text="The model in use can't see images: pick one that can at the top." />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Grid.Row="0" Grid.Column="1" Classes="card">
              <DockPanel>
                <PathIcon Classes="capability" Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" />
                <StackPanel Spacing="3">
                  <TextBlock Classes="capability" Text="Files and commands" />
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="I read, write and edit files anywhere on this PC and run PowerShell commands." />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="0" Classes="card">
              <DockPanel>
                <PathIcon Classes="capability" Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" />
                <StackPanel Spacing="3">
                  <TextBlock Classes="capability" Text="Documents" />
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="I write and edit Word, Excel, PowerPoint and PDF files, no Office needed, and read pictures." />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Classes="card">
              <DockPanel>
                <PathIcon Classes="capability" Data="M20.5 11H19V7c0-1.1-.9-2-2-2h-4V3.5C13 2.12 11.88 1 10.5 1S8 2.12 8 3.5V5H4c-1.1 0-1.99.9-1.99 2v3.8H3.5c1.49 0 2.7 1.21 2.7 2.7s-1.21 2.7-2.7 2.7H2V20c0 1.1.9 2 2 2h3.8v-1.5c0-1.49 1.21-2.7 2.7-2.7 1.49 0 2.7 1.21 2.7 2.7V22H17c1.1 0 2-.9 2-2v-4h1.5c1.38 0 2.5-1.12 2.5-2.5S21.88 11 20.5 11z" />
                <StackPanel Spacing="3">
                  <TextBlock Classes="capability" Text="Get what a job needs" />
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="I download the programs a job needs and connect their MCP servers myself, like Blender's for 3D modelling." />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Grid.Row="2" Grid.Column="0" Classes="card">
              <DockPanel>
                <PathIcon Classes="capability" Data="M21 6h-2v9H6v2c0 .55.45 1 1 1h11l4 4V7c0-.55-.45-1-1-1zm-4 6V3c0-.55-.45-1-1-1H3c-.55 0-1 .45-1 1v14l4-4h10c.55 0 1-.45 1-1z" />
                <StackPanel Spacing="3">
                  <TextBlock Classes="capability" Text="Chat for you" />
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="I answer people in your chat apps while you're away, and say I'm your assistant if asked." />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Grid.Row="2" Grid.Column="1" Classes="card">
              <DockPanel>
                <PathIcon Classes="capability" Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
                <StackPanel Spacing="3">
                  <TextBlock Classes="capability" Text="Look things up" />
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="I search the web and read pages when I'm not sure of something." />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Grid.Row="3" Grid.Column="0" Classes="card">
              <DockPanel>
                <PathIcon Classes="capability" Data="M20 13H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1v-6c0-.55-.45-1-1-1zM7 19c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zM20 3H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1V4c0-.55-.45-1-1-1zM7 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" />
                <StackPanel Spacing="3">
                  <TextBlock Classes="capability" Text="Work on servers" />
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="I log in over SSH to set servers up or fix them, and copy files to and from them." />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Grid.Row="3" Grid.Column="1" Classes="card">
              <DockPanel>
                <PathIcon Classes="capability" Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" />
                <StackPanel Spacing="3">
                  <TextBlock Classes="capability" Text="Long jobs" />
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="I keep going for hours when a job needs it, like making a game and play-testing it." />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Classes="card">
              <DockPanel>
                <PathIcon Classes="capability" Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" />
                <StackPanel Spacing="3">
                  <TextBlock Classes="capability" Text="Pictures, video and sound" />
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="I make pictures, videos, music, speech and 3D models with ComfyUI, which I install with the models a job needs, also on a PC without a graphics card. You can look at them, play them and turn them around right here." />
                </StackPanel>
              </DockPanel>
            </Border>
          </Grid>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Input -->
    <Border Grid.Row="4" Padding="16,8,16,14">
      <StackPanel MaxWidth="860" Spacing="6">
        <!-- While the user types to it during a run, the agent's clicks and keys wait; said here,
             so the pause doesn't look like a hang and they know their typing is safe. -->
        <DockPanel IsVisible="{Binding TypingPause}" Margin="4,0">
          <PathIcon DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,8,0" Foreground="{StaticResource BbAccent}"
                    VerticalAlignment="Center" Data="M3,2 H6 V14 H3 Z M10,2 H13 V14 H10 Z" />
          <!-- Resume lets the agent go on at once and keeps the draft, for someone who started typing and changed their mind. -->
          <Button DockPanel.Dock="Right" Classes="ghost" Content="Resume" Command="{Binding ResumeCommand}" Margin="8,0,0,0" Padding="10,2"
                  VerticalAlignment="Center" ToolTip.Tip="Let me carry on now; what you typed stays in the box." />
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BbAccent}" VerticalAlignment="Center" Text="{Binding TypingPauseText}" />
        </DockPanel>
        <!-- One line of text is exactly as tall as the Send button, and both sit on the same
             bottom edge, so they line up; longer text grows the box upwards with Send staying put. -->
        <Border Classes="card composer" Padding="6">
          <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
            <!-- The files going with the message (dropped, pasted or picked); × takes one off. -->
            <ItemsControl Grid.Row="0" Grid.ColumnSpan="3" ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}" Margin="4,8,4,4">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AttachmentItem">
                  <Panel Margin="0,0,12,6" ToolTip.Tip="{Binding Tip}">
                    <Border Classes="attachment" IsVisible="{Binding !ShowsName}">
                      <Image Source="{Binding Thumbnail}" Height="64" MaxWidth="160" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="MediumQuality" />
                    </Border>
                    <Border Classes="attachment file" IsVisible="{Binding ShowsName}" MinHeight="36">
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,10,0">
                        <PathIcon Data="{Binding Icon}" />
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding FileName}" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="muted" Text="{Binding Details}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <Button Classes="removeAttachment" Command="{Binding RemoveCommand}" ToolTip.Tip="Take it off the message"
                            AutomationProperties.Name="{Binding FileName, StringFormat='Remove {0}'}">
                      <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                    </Button>
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Files go with a message from here too, besides dropping them on the window or pasting them. -->
            <Button x:Name="AttachButton" Grid.Row="1" Grid.Column="0" Classes="ghost" BorderThickness="0" Padding="6" Margin="0,0,4,0" VerticalAlignment="Bottom" MinHeight="32"
                    Click="OnAttachClick" AutomationProperties.Name="Attach files"
                    ToolTip.Tip="Attach files or pictures to your message. You can also drop them on this window, or paste a screenshot or copied files with Ctrl+V.">
              <PathIcon Width="18" Height="18" Foreground="{StaticResource BbMuted}"
                        Data="M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5c0-1.38 1.12-2.5 2.5-2.5s2.5 1.12 2.5 2.5v10.5c0 .55-.45 1-1 1s-1-.45-1-1V6H10v9.5c0 1.38 1.12 2.5 2.5 2.5s2.5-1.12 2.5-2.5V5c0-2.21-1.79-4-4-4S7 2.79 7 5v12.5c0 3.04 2.46 5.5 5.5 5.5s5.5-2.46 5.5-5.5V6h-1.5z" />
            </Button>
            <!-- During a run Send stays: a message then goes to the agent before its next step. -->
            <TextBox x:Name="InputBox" Grid.Row="1" Grid.Column="1" Classes="composer" Text="{Binding Input}" AcceptsReturn="True" TextWrapping="Wrap"
                     MaxHeight="200" VerticalContentAlignment="Center"
                     Watermark="{Binding InputHint}" />
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom" Margin="8,0,0,0">
              <Button Classes="primary" Content="Send" Command="{Binding SendCommand}" MinHeight="32" />
              <Button Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding IsBusy}" Background="{StaticResource BbError}" MinHeight="32" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Border>

    <!-- Files dragged over the window: where they go. The drop itself lands on the window. -->
    <Panel Grid.Row="0" Grid.RowSpan="5" IsVisible="{Binding IsDropping}" IsHitTestVisible="False" Background="#EC111214">
      <Rectangle Margin="14" RadiusX="12" RadiusY="12" Stroke="{StaticResource BbAccent}" StrokeThickness="2" StrokeDashArray="6,4" />
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <PathIcon Width="36" Height="36" Foreground="{StaticResource BbAccent}" HorizontalAlignment="Center"
                  Data="M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5c0-1.38 1.12-2.5 2.5-2.5s2.5 1.12 2.5 2.5v10.5c0 .55-.45 1-1 1s-1-.45-1-1V6H10v9.5c0 1.38 1.12 2.5 2.5 2.5s2.5-1.12 2.5-2.5V5c0-2.21-1.79-4-4-4S7 2.79 7 5v12.5c0 3.04 2.46 5.5 5.5 5.5s5.5-2.46 5.5-5.5V6h-1.5z" />
        <TextBlock Text="Drop to attach" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" Text="They go with your next message, and I can work with them." HorizontalAlignment="Center" />
      </StackPanel>
    </Panel>
  </Grid>
</Window>
