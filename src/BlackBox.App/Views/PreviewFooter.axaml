<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BlackBox.App.ViewModels"
             xmlns:views="using:BlackBox.App.Views"
             x:Class="BlackBox.App.Views.PreviewFooter"
             x:DataType="vm:FilePreview">
  <!-- Under every preview: the file's name and what it is, and buttons to open it or find it; for a
       file made with a prompt, Prompt shows that prompt and the settings it was made with. -->
  <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="10,0,0,0">
      <Button Classes="ghost" Padding="10,3" Content="Prompt" IsVisible="{Binding HasRecipe}"
              ToolTip.Tip="The prompts and settings it was made with, read from the file">
        <Button.Flyout>
          <Flyout Placement="TopEdgeAlignedRight">
            <ScrollViewer MaxHeight="520" Width="440" HorizontalScrollBarVisibility="Disabled">
              <views:RecipeView DataContext="{Binding Recipe}" Margin="4,2,14,4" />
            </ScrollViewer>
          </Flyout>
        </Button.Flyout>
      </Button>
      <Button Classes="ghost" Padding="10,3" Content="Open" Command="{Binding OpenCommand}" ToolTip.Tip="Open it in its own program" />
      <Button Classes="ghost" Padding="10,3" Content="Show in folder" Command="{Binding ShowInFolderCommand}" ToolTip.Tip="{Binding Path}" />
    </StackPanel>
    <StackPanel Spacing="1" VerticalAlignment="Center">
      <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
      <TextBlock Classes="muted" Text="{Binding Details}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Details}" />
    </StackPanel>
  </DockPanel>
</UserControl>
