<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BlackBox.App.ViewModels"
        x:Class="BlackBox.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="BlackBox settings"
        Icon="/Assets/blackbox.ico"
        Width="720" Height="700" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style Selector="Grid.form > ComboBox">
      <Setter Property="Margin" Value="0,4" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{StaticResource BbSurface}" BorderBrush="{StaticResource BbBorder}" BorderThickness="0,1,0,0" Padding="16,10">
      <!-- The buttons first: a long folder path is cut short instead of pushing them out of the window. -->
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
          <Button Classes="ghost" Content="Cancel" Click="OnCancel" />
          <Button Classes="primary" Content="Save" Click="OnSave" />
        </StackPanel>
        <TextBlock Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Text="{Binding Paths.SettingsFile, StringFormat='Saved to {0}'}" ToolTip.Tip="{Binding Paths.SettingsFile}" />
      </DockPanel>
    </Border>

    <ScrollViewer Margin="16,8">
      <StackPanel Spacing="4" Margin="0,0,12,16">
        <TextBlock Classes="h2" Text="Safety" />
        <Grid Classes="form" ColumnDefinitions="140,*">
          <TextBlock Classes="label" Text="Ask me first" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding ApprovalModes}" SelectedIndex="{Binding ApprovalIndex}" HorizontalAlignment="Stretch" />
        </Grid>

        <TextBlock Classes="h2" Text="Things BlackBox should always know" />
        <TextBox Text="{Binding Agent.CustomInstructions}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"
                 Watermark="For example: my documents are in D:\Docs. Use Firefox for browsing. Answer in German." />

        <TextBlock Classes="h2" Text="MCP servers" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="Tools from other programs, like Blender. BlackBox adds what a task needs here by itself." />
        <TextBox x:Name="McpBox" Text="{Binding McpConfigText}" Watermark="{Binding McpExample}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                 FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="12" MinHeight="200" Margin="0,8,0,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ToolTip.Tip="You can paste a server's &quot;mcpServers&quot; block from its instructions here too: Claude Desktop, LM Studio and Cursor use the same format." />
        <SelectableTextBlock Classes="muted error" TextWrapping="Wrap" Text="{Binding McpError}" IsVisible="{Binding HasMcpError}" />
        <SelectableTextBlock Classes="muted" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding McpStatusText}" IsVisible="{Binding HasMcpStatus}" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,4,0,0" Text="BlackBox starts these when you click Save and each time it opens."
                   ToolTip.Tip="{Binding Paths.McpConfigFile, StringFormat='Kept in {0}'}" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
