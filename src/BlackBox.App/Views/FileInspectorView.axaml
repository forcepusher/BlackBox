<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BlackBox.App.ViewModels"
             xmlns:views="using:BlackBox.App.Views"
             x:Class="BlackBox.App.Views.FileInspectorView"
             x:DataType="vm:FileInspectorViewModel">
  <!-- The file itself, as the File inspector panel and the full-screen viewer show it. -->
  <Grid RowDefinitions="*,Auto">
    <Panel>
      <TextBlock Classes="muted" Text="{Binding Message}" IsVisible="{Binding HasMessage}" HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center" />

      <!-- Markdown and tables, as a reply is drawn; text selected in it, or in the text below, goes
           into the chat's box (see FileInspectorView.axaml.cs). The left margin is inside the scroller, so the
           text's selection margin isn't cut off. -->
      <ScrollViewer x:Name="DocumentScroll" IsVisible="{Binding ShowsMarkdown}" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Document">
        <views:MarkdownView x:Name="Document" KeepsSelection="True" Source="{Binding Markdown}" Margin="20,16,20,20" />
      </ScrollViewer>

      <ScrollViewer x:Name="TextScroll" IsVisible="{Binding ShowsText}" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Document text">
        <views:KeptSelectionTextBlock x:Name="PlainText" Text="{Binding Text}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" Margin="16,12,16,16" TextWrapping="NoWrap" />
      </ScrollViewer>

      <!-- A picture: zoomed with the wheel, panned with a right drag, an area marked with a left one. -->
      <views:ZoomBox x:Name="PictureBox" Source="{Binding Picture}" IsVisible="{Binding Picture, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="16"
                     Zoom="{Binding Zoom}" Mark="{Binding Mark, Mode=TwoWay}" CanMark="{Binding CanPick}" AutomationProperties.Name="Picture" />

      <!-- A video's frame, the same; its player is under it. -->
      <views:ZoomBox x:Name="FrameBox" Source="{Binding Video.Frame}" IsVisible="{Binding Video, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="16,16,16,8"
                     Zoom="{Binding Zoom}" Mark="{Binding Mark, Mode=TwoWay}" CanMark="{Binding CanPick}" AutomationProperties.Name="Video frame" />

      <!-- An animation, a sound or a 3D model: as in the chat. -->
      <ScrollViewer IsVisible="{Binding Media, Converter={x:Static ObjectConverters.IsNotNull}}" HorizontalScrollBarVisibility="Disabled">
        <ContentControl Content="{Binding Media}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" />
      </ScrollViewer>

      <!-- A PDF's pages, drawn by PDFium as they come on screen: the list makes only the pages in view.
           Its width is set in code: the panel's, times the zoom (Ctrl+wheel or the buttons). -->
      <ScrollViewer x:Name="PdfScroll" IsVisible="{Binding Pages, Converter={x:Static ObjectConverters.IsNotNull}}" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="PDF pages">
        <ItemsControl x:Name="PagesList" ItemsSource="{Binding Pages}" Margin="16,12,16,16" HorizontalAlignment="Left">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PdfPageItem">
              <views:PdfPageView HorizontalAlignment="Center" Margin="0,0,0,12" AutomationProperties.Name="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Office files and web pages (and a PDF PDFium can't open), drawn by Windows' previewer for them. -->
      <views:ShellPreviewHost x:Name="Shell" Path="{Binding ShellPath}" IsVisible="{Binding ShowsShell}" />

      <!-- With Area on: the view frozen, to drag an area over. -->
      <views:ZoomBox x:Name="FrozenBox" Source="{Binding Frozen}" IsVisible="{Binding Frozen, Converter={x:Static ObjectConverters.IsNotNull}}"
                     Zoom="{Binding Zoom}" Mark="{Binding Mark, Mode=TwoWay}" CanMark="True" AutomationProperties.Name="Frozen view" />

      <!-- Zoom: out, back to fit, in. -->
      <Border IsVisible="{Binding CanZoom}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,14" CornerRadius="6" Padding="2"
              Background="{StaticResource BbSurfaceRaised}" BorderBrush="{StaticResource BbBorder}" BorderThickness="1">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Classes="ghost" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom out" AutomationProperties.Name="Zoom out">
            <PathIcon Width="11" Height="11" Data="M19 13H5v-2h14v2z" />
          </Button>
          <Button Classes="ghost" MinWidth="44" Height="26" Padding="6,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Command="{Binding ZoomFitCommand}" Content="{Binding ZoomText}" FontSize="12" ToolTip.Tip="Fit" AutomationProperties.Name="Zoom to fit" />
          <Button Classes="ghost" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom in" AutomationProperties.Name="Zoom in">
            <PathIcon Width="11" Height="11" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
          </Button>
        </StackPanel>
      </Border>
    </Panel>

    <!-- A video's player: a frame back, play, a frame on; where it is; its sound. -->
    <Border Grid.Row="1" IsVisible="{Binding Video, Converter={x:Static ObjectConverters.IsNotNull}}" Padding="10,4,10,10">
      <DockPanel DataContext="{Binding Video}" x:DataType="vm:InspectorVideoViewModel">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Classes="ghost" Width="30" Height="30" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Command="{Binding StepBackCommand}" ToolTip.Tip="A frame back (Left)" AutomationProperties.Name="A frame back">
            <PathIcon Width="13" Height="13" Data="M6 6h2v12H6zm3.5 6l8.5 6V6z" />
          </Button>
          <Button Classes="ghost" Width="30" Height="30" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Command="{Binding PlayCommand}" ToolTip.Tip="Play or pause (Space)" AutomationProperties.Name="Play">
            <PathIcon Width="14" Height="14" Data="{Binding PlayIcon}" />
          </Button>
          <Button Classes="ghost" Width="30" Height="30" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Command="{Binding StepForwardCommand}" ToolTip.Tip="A frame on (Right)" AutomationProperties.Name="A frame on">
            <PathIcon Width="13" Height="13" Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" />
          </Button>
        </StackPanel>
        <Button DockPanel.Dock="Right" Classes="ghost" Width="30" Height="30" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Command="{Binding ToggleSoundCommand}" ToolTip.Tip="Sound on or off" AutomationProperties.Name="Sound">
          <PathIcon Width="14" Height="14" Data="{Binding SoundIcon}" />
        </Button>
        <!-- Where it is, in a slot as wide as its longest text for this video (hidden under it), its
             figures all as wide: the slider beside it keeps still as the text changes. -->
        <Panel DockPanel.Dock="Right" Margin="10,0,6,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding LongestFrameText}" FontSize="12" FontFeatures="+tnum" Opacity="0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
          <TextBlock Classes="muted" Text="{Binding FrameText}" FontSize="12" FontFeatures="+tnum" HorizontalAlignment="Right" AutomationProperties.Name="Frame" />
        </Panel>
        <Slider Minimum="0" Maximum="{Binding LastFrame}" Value="{Binding SliderFrame}" SmallChange="1" LargeChange="10" VerticalAlignment="Center" Margin="8,0,0,0"
                AutomationProperties.Name="Frame slider" />
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
