<Project Sdk="Microsoft.NET.Sdk">

  <!-- Only referenced when building on Windows (see the conditional references in the app
       projects), so the rest of the solution stays plain net10.0 for Linux/macOS ports. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Sloperator.Platform.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The published exe is trimmed: flag code that needs reflection while it is written. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sloperator.Core\Sloperator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sloperator.Core.Tests" />
  </ItemGroup>

</Project>
