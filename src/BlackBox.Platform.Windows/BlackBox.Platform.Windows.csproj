<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain net10.0 (not net10.0-windows) so the app still builds on Linux/macOS;
       every entry point is guarded with OperatingSystem.IsWindows(). -->
  <PropertyGroup>
    <RootNamespace>BlackBox.Platform.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlackBox.Core\BlackBox.Core.csproj" />
  </ItemGroup>

</Project>
