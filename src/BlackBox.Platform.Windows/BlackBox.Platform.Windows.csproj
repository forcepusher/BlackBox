<Project Sdk="Microsoft.NET.Sdk">

  <!-- Only referenced when building on Windows (see the conditional references in the app
       projects), so the rest of the solution stays plain net10.0 for Linux/macOS ports. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>BlackBox.Platform.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlackBox.Core\BlackBox.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlackBox.Core.Tests" />
  </ItemGroup>

</Project>
