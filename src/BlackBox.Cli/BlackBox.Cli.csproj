<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless runner: same agent, same tools, output in the console. Handy for trying tasks
       and models without the UI, and for scripted runs. -->
  <PropertyGroup>
    <!-- Windows builds include the Windows desktop backend; other OSes build the portable core only. -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>blackbox-cli</AssemblyName>
    <RootNamespace>BlackBox.Cli</RootNamespace>
    <ApplicationManifest>..\BlackBox.App\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Builds carry their own .NET, so blackbox-cli.exe also runs on a PC without .NET installed
       (see BlackBox.App.csproj). -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlackBox.Core\BlackBox.Core.csproj" />
    <ProjectReference Include="..\BlackBox.Platform.Windows\BlackBox.Platform.Windows.csproj" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

</Project>
