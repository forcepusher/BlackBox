<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sloperator.App.ViewModels"
             xmlns:views="using:Sloperator.App.Views"
             x:Class="Sloperator.App.Views.CodeEditorPanel"
             x:DataType="vm:CodeEditorViewModel"
             Background="{StaticResource BbBackground}">

  <UserControl.Styles>
    <!-- The file open, or the folder last clicked: grey, not the yellow of what goes with a message, as
         nothing of the tree does (only lines selected in the file). -->
    <Style Selector="ListBox.tree ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.tree ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.tree ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BbChip}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- The folder shown, or how the panel is used; Open folder, Wrap and Watch (as File changes has them), then × to close the panel. A bar as the
         chat's top bar beside it. -->
    <Border DockPanel.Dock="Top" Classes="bar">
      <DockPanel MinHeight="32">
        <views:SidePanelClose DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
        <!-- Watch: the file the agent edits opens at the lines it changed, lit a moment, as in File
             changes; there from the start. -->
        <ToggleButton DockPanel.Dock="Right" Classes="ghost" IsChecked="{Binding Watch}" Margin="8,0,0,0"
                      ToolTip.Tip="Follow the agent's changes as they happen" AutomationProperties.Name="Watch">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Width="14" Height="14" Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" />
            <TextBlock Text="Watch" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton DockPanel.Dock="Right" Classes="ghost" IsChecked="{Binding Wrap}" Margin="8,0,0,0"
                      ToolTip.Tip="Wrap long lines" AutomationProperties.Name="Wrap">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Width="14" Height="14" Data="M4 19h6v-2H4v2zM20 5H4v2h16V5zm-3 6H4v2h13.25c1.1 0 2 .9 2 2s-.9 2-2 2H15v-2l-3 3 3 3v-2h2c2.21 0 4-1.79 4-4s-1.79-4-4-4z" />
            <TextBlock Text="Wrap" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <Button DockPanel.Dock="Right" Classes="ghost" Margin="12,0,0,0" Click="OnOpenFolder"
                ToolTip.Tip="Open a folder to browse and edit its files" AutomationProperties.Name="Open folder">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Width="14" Height="14" Data="M19 20H4a2 2 0 0 1-2-2V6c0-1.11.89-2 2-2h6l2 2h7a2 2 0 0 1 2 2H4v10l2.14-8h17.07l-2.28 8.5c-.23.87-1.01 1.5-1.93 1.5z" />
            <TextBlock Text="Open folder" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Panel>
          <!-- A long path is cut at its start: the folder's own name stays. -->
          <TextBlock Classes="muted" IsVisible="{Binding HasFolder}" Text="{Binding Folder}" TextTrimming="LeadingCharacterEllipsis"
                     VerticalAlignment="Center" ToolTip.Tip="{Binding Folder}" />
          <TextBlock Classes="muted" IsVisible="{Binding !HasFolder}" Text="{Binding Status}" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" ToolTip.Tip="{Binding Status}" />
        </Panel>
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="230,4,*">
      <!-- The folder's files: a click on a folder unfolds or folds it, on a file opens it; Left and Right
           fold and unfold, Enter opens. A right-click offers the file's folder. -->
      <ListBox x:Name="Tree" Grid.Column="0" Classes="files tree" ItemsSource="{Binding Tree.Rows}" SelectedItem="{Binding SelectedRow}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ContextRequested="OnTreeMenu" AutomationProperties.Name="Files">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:FileTreeRow">
            <!-- A folder's arrow, or the room of one; the name; a dot while it has edits not saved. -->
            <DockPanel Margin="{Binding Indent}" ToolTip.Tip="{Binding Path}">
              <Panel DockPanel.Dock="Left" Width="10" Margin="0,0,4,0" VerticalAlignment="Center">
                <PathIcon Classes="fold" Classes.open="{Binding IsExpanded}" Width="10" Height="10" Data="M7 10l5 5 5-5z" IsVisible="{Binding IsFolder}" />
              </Panel>
              <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Margin="8,0,0,0" Fill="{StaticResource BbMuted}" IsVisible="{Binding IsUnsaved}"
                       VerticalAlignment="Center" ToolTip.Tip="Not saved" />
              <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <!-- Save (Ctrl+S) and Reload, there from the start and greyed while there is nothing to do (the
           user, 2026-10-31: bar buttons never come and go mid-task), and the file's path in the folder
           with whether it is saved. -->
      <DockPanel Grid.Column="2">
        <Border DockPanel.Dock="Top" Classes="bar" Padding="8">
          <DockPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
              <Button Classes="ghost small act" Command="{Binding SaveCommand}" ToolTip.ShowOnDisabled="True" ToolTip.Tip="Save (Ctrl+S)" AutomationProperties.Name="Save">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Width="12" Height="12" Data="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z" />
                  <TextBlock Text="Save" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="ghost small act" Command="{Binding ReloadCommand}" ToolTip.ShowOnDisabled="True"
                      ToolTip.Tip="Take the file as it is on disk, in place of the edits here, once both changed" AutomationProperties.Name="Reload">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Width="12" Height="12" Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
                  <TextBlock Text="Reload" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Classes="muted" Text="{Binding FileStatus}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding OpenPath}" />
          </DockPanel>
        </Border>
        <Panel>
          <TextBlock Classes="muted" IsVisible="{Binding !HasFile}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"
                     Text="{Binding EmptyText}" />
          <!-- The file's text, its lines numbered; lines selected go into the chat's box. -->
          <views:CodeView x:Name="Editor" IsVisible="{Binding HasFile}" WordWrap="{Binding Wrap}" ShowLineNumbers="True" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"
                          Background="Transparent" Foreground="{StaticResource BbCode}" LineNumbersForeground="{StaticResource BbFaint}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Code" />
        </Panel>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
