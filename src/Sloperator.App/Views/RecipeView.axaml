<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:media="using:Sloperator.Core.Media"
             x:Class="Sloperator.App.Views.RecipeView"
             x:DataType="media:MediaRecipe">
  <!-- What a file says it was made with: each prompt with Copy, then the settings, then Copy all. -->
  <StackPanel Spacing="12">
    <ItemsControl ItemsSource="{Binding Texts}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="12" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="media:RecipeText">
          <StackPanel Spacing="4">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="ghost" Padding="10,2" Content="Copy" Click="OnCopyText"
                      ToolTip.Tip="Put it on the clipboard" AutomationProperties.Name="{Binding Label, StringFormat='Copy {0}'}" />
              <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <ItemsControl ItemsSource="{Binding Settings}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="media:RecipeSetting">
          <Grid ColumnDefinitions="110,*" Margin="0,1">
            <TextBlock Classes="muted" Text="{Binding Name}" />
            <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <DockPanel>
      <Button DockPanel.Dock="Right" Classes="ghost" Padding="10,3" Content="Copy all" Click="OnCopyAll"
              ToolTip.Tip="The prompts and settings as text" />
      <TextBlock Classes="muted" Text="{Binding MadeWith, StringFormat='Read from the file, as {0} saved it.'}" VerticalAlignment="Center" TextWrapping="Wrap" />
    </DockPanel>
  </StackPanel>
</UserControl>
