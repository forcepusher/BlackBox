<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sloperator.App.ViewModels"
        xmlns:views="using:Sloperator.App.Views"
        x:Class="Sloperator.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Sloperator settings"
        Icon="/Assets/sloperator.ico"
        Width="720" Height="733" MinWidth="560" MinHeight="513"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="Grid.form > ComboBox">
      <Setter Property="Margin" Value="0,4" />
    </Style>
    <!-- A label sat a pixel under the words of the field beside it at 125%, where every label of the
         chat's bars is level with its field's: 0.8 more under it lifts it that pixel. -->
    <Style Selector="Grid.form > TextBlock.label">
      <Setter Property="Margin" Value="0,0,0,0.8" />
    </Style>
    <!-- NumericUpDown isn't in the UI Automation tree, only its text box: give that the field's name. -->
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
      <Setter Property="AutomationProperties.Name" Value="{Binding $parent[NumericUpDown].(AutomationProperties.Name)}" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <views:TitleBar DockPanel.Dock="Top" />
    <Border DockPanel.Dock="Bottom" Classes="bar foot">
      <!-- The buttons first: a long folder path is cut short instead of pushing them out of the window. -->
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
          <Button Classes="ghost" Content="Cancel" Click="OnCancel" />
          <Button Classes="primary" Content="Save" Click="OnSave" />
        </StackPanel>
        <TextBlock Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Text="{Binding Paths.SettingsFile, StringFormat='Saved to {0}'}" ToolTip.Tip="{Binding Paths.SettingsFile}" />
      </DockPanel>
    </Border>

    <!-- Everyday options in General, the ones most people never touch in Advanced. -->
    <TabControl x:Name="Tabs">
      <TabItem Header="General">
        <ScrollViewer>
          <StackPanel Spacing="4" Margin="16,8,28,24">
            <TextBlock Classes="h2" Text="Things Sloperator should always know" />
            <TextBox Text="{Binding Agent.CustomInstructions}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"
                     PlaceholderText="For example: my documents are in D:\Docs. Use Firefox for browsing. Answer in German." />

            <TextBlock Classes="h2" Text="Notifications" />
            <CheckBox IsChecked="{Binding Notify.WhenDone}" Content="Notify me when done"
                      ToolTip.Tip="A Windows notification when a task is done, stops on an error or waits for your OK, unless you are looking at its window." />

            <TextBlock Classes="h2" Text="Safety" />
            <Grid Classes="form" ColumnDefinitions="160,*">
              <TextBlock Classes="label" Text="Tool call approval" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding ApprovalModes}" SelectedIndex="{Binding ApprovalIndex}" HorizontalAlignment="Stretch" />
            </Grid>
            <CheckBox x:Name="ScreenshotsBox" IsChecked="{Binding Agent.EnableScreenshots}" Content="Enable screenshots" />
            <!-- No clicking blind: the mouse and keyboard only go with screenshots. -->
            <CheckBox IsChecked="{Binding Agent.EnableControl}" IsEnabled="{Binding #ScreenshotsBox.IsChecked}" Content="Enable keyboard and mouse control" />

            <StackPanel Spacing="4" IsVisible="{Binding ShowsTextRecognition}">
              <TextBlock Classes="h2" Text="Text recognition" />
              <CheckBox IsChecked="{Binding Agent.EnableTextRecognition}" Content="Use text recognition" />
              <Grid Classes="form" ColumnDefinitions="160,*">
                <TextBlock Classes="label" Text="Languages" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,4">
                  <TextBlock Text="{Binding TextRecognition}" VerticalAlignment="Center" />
                  <Button Classes="ghost" Content="Add a language" Command="{Binding OpenLanguageSettingsCommand}"
                          ToolTip.Tip="Opens Windows' language settings: a language added there brings its text recognition" />
                </StackPanel>
              </Grid>
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Makes model's clicks more accurate. Not used or offered when disabled." />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Advanced">
        <ScrollViewer>
          <StackPanel Spacing="4" Margin="16,8,28,24">
            <TextBlock Classes="h2" Text="Updates" />
            <TextBlock Classes="muted" Text="{Binding Updater.VersionText}" />
            <CheckBox IsChecked="{Binding Updates.Automatic}" Content="Check automatically"
                      ToolTip.Tip="At start and once an hour Sloperator asks GitHub for a new version and downloads it. Off, it never contacts GitHub by itself." />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Classes="ghost" Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" />
              <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding Updater.Status}" />
            </StackPanel>

            <TextBlock Classes="h2" Text="Screenshots" />
            <Grid Classes="form" ColumnDefinitions="160,*">
              <TextBlock Classes="label" Text="Screenshot size" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding ScreenshotSizes}" SelectedIndex="{Binding ScreenshotSizeIndex}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Screenshot size" />
            </Grid>
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Taller screens are scaled down, never up. Smaller uses less context, but clicks miss more." />

            <TextBlock Classes="h2" Text="MCP servers" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="Tools from other programs, like Blender. Sloperator adds them as needed."
                       ToolTip.Tip="{Binding Paths.McpConfigFile, StringFormat='Kept in {0}'}" />
            <TextBox x:Name="McpBox" Text="{Binding McpConfigText}" PlaceholderText="{Binding McpExample}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                     FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="12" MinHeight="200" Margin="0,8,0,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ToolTip.Tip="Same format as Claude Desktop, LM Studio and Cursor" />
            <views:SelectableText Classes="muted error" TextWrapping="Wrap" Text="{Binding McpError}" IsVisible="{Binding HasMcpError}" />
            <views:SelectableText Classes="muted" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding McpStatusText}" IsVisible="{Binding HasMcpStatus}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
