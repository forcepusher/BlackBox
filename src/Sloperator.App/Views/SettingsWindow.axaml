<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sloperator.App.ViewModels"
        xmlns:views="using:Sloperator.App.Views"
        x:Class="Sloperator.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Sloperator settings"
        Icon="/Assets/sloperator.ico"
        Width="720" Height="700" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="Grid.form > ComboBox">
      <Setter Property="Margin" Value="0,4" />
    </Style>
    <!-- A label sat a pixel under the words of the field beside it at 125%, where every label of the
         chat's bars is level with its field's: 0.8 more under it lifts it that pixel. -->
    <Style Selector="Grid.form > TextBlock.label">
      <Setter Property="Margin" Value="0,0,0,0.8" />
    </Style>
    <!-- NumericUpDown isn't in the UI Automation tree, only its text box: give that the field's name. -->
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
      <Setter Property="AutomationProperties.Name" Value="{Binding $parent[NumericUpDown].(AutomationProperties.Name)}" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="bar foot">
      <!-- The buttons first: a long folder path is cut short instead of pushing them out of the window. -->
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
          <Button Classes="ghost" Content="Cancel" Click="OnCancel" />
          <Button Classes="primary" Content="Save" Click="OnSave" />
        </StackPanel>
        <TextBlock Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Text="{Binding Paths.SettingsFile, StringFormat='Saved to {0}'}" ToolTip.Tip="{Binding Paths.SettingsFile}" />
      </DockPanel>
    </Border>

    <ScrollViewer>
      <StackPanel Spacing="4" Margin="16,8,28,24">
        <TextBlock Classes="h2" Text="Side panel" />
        <CheckBox IsChecked="{Binding Panels.OpenFileChanges}" Content="Open File changes when the agent first changes a file in a chat" />

        <TextBlock Classes="h2" Text="Safety" />
        <Grid Classes="form" ColumnDefinitions="160,*">
          <TextBlock Classes="label" Text="Ask me first" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding ApprovalModes}" SelectedIndex="{Binding ApprovalIndex}" HorizontalAlignment="Stretch" />
        </Grid>
        <CheckBox x:Name="ScreenshotsBox" IsChecked="{Binding Agent.EnableScreenshots}" Content="Enable screenshots" />
        <!-- No clicking blind: the mouse and keyboard only go with screenshots. -->
        <CheckBox IsChecked="{Binding Agent.EnableControl}" IsEnabled="{Binding #ScreenshotsBox.IsChecked}" Content="Enable keyboard and mouse control" />

        <TextBlock Classes="h2" Text="Things Sloperator should always know" />
        <TextBox Text="{Binding Agent.CustomInstructions}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"
                 Watermark="For example: my documents are in D:\Docs. Use Firefox for browsing. Answer in German." />

        <TextBlock Classes="h2" Text="MCP servers" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="Tools from other programs, like Blender. Sloperator adds what a task needs here by itself." />
        <TextBox x:Name="McpBox" Text="{Binding McpConfigText}" Watermark="{Binding McpExample}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                 FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="12" MinHeight="200" Margin="0,8,0,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ToolTip.Tip="You can paste a server's &quot;mcpServers&quot; block from its instructions here too: Claude Desktop, LM Studio and Cursor use the same format." />
        <views:SelectableText Classes="muted error" TextWrapping="Wrap" Text="{Binding McpError}" IsVisible="{Binding HasMcpError}" />
        <views:SelectableText Classes="muted" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding McpStatusText}" IsVisible="{Binding HasMcpStatus}" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,4,0,0" Text="Sloperator starts these when you click Save and each time it opens."
                   ToolTip.Tip="{Binding Paths.McpConfigFile, StringFormat='Kept in {0}'}" />

        <TextBlock Classes="h2" Text="Advanced" />
        <Grid Classes="form" ColumnDefinitions="160,*">
          <TextBlock Classes="label" Text="Max screenshot size" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,4">
            <NumericUpDown x:Name="ScreenshotWidthBox" Value="{Binding ScreenshotWidth}" LostFocus="OnSizeLostFocus" Minimum="{x:Static vm:SettingsViewModel.MinWidth}" Maximum="{x:Static vm:SettingsViewModel.MaxSide}"
                           Increment="64" FormatString="0" ClipValueToMinMax="True" Width="96" ShowButtonSpinner="False" AutomationProperties.Name="Max screenshot width" />
            <TextBlock Text="×" VerticalAlignment="Center" />
            <NumericUpDown x:Name="ScreenshotHeightBox" Value="{Binding ScreenshotHeight}" LostFocus="OnSizeLostFocus" Minimum="{x:Static vm:SettingsViewModel.MinHeight}" Maximum="{x:Static vm:SettingsViewModel.MaxSide}"
                           Increment="64" FormatString="0" ClipValueToMinMax="True" Width="96" ShowButtonSpinner="False" AutomationProperties.Name="Max screenshot height" />
            <TextBlock Classes="muted" Text="pixels" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Larger screens are scaled down to fit and use less context. 2560 × 1080 by default." />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
