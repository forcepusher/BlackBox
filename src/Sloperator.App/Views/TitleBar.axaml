<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Sloperator.App.Views"
             x:Class="Sloperator.App.Views.TitleBar">
  <!-- The window's title bar, drawn by the app (App.axaml, "The title bar"). Only the buttons are hit:
       everywhere else Windows takes the strip for its own caption, to drag, snap, double-click and
       right-click. -->
  <Panel>
    <Border Classes="titleStrip" IsHitTestVisible="False" />
    <!-- The buttons docked from the right edge in, so Close ends on it at every scale (in a row of
         their own, three widths rounded at 125% left a pixel between Close and the screen's corner). -->
    <DockPanel Classes="titleStrip">
      <Button x:Name="CloseButton" DockPanel.Dock="Right" Classes="caption close" Click="OnClose" AutomationProperties.Name="Close" ToolTip.Tip="Close">
        <views:CaptionGlyph Kind="Close" />
      </Button>
      <Button x:Name="MaximizeButton" DockPanel.Dock="Right" Classes="caption" Click="OnMaximize" AutomationProperties.Name="Maximize">
        <Panel>
          <views:CaptionGlyph Classes="maximize" Kind="Maximize" />
          <views:CaptionGlyph Classes="restore" Kind="Restore" />
        </Panel>
      </Button>
      <Button x:Name="MinimizeButton" DockPanel.Dock="Right" Classes="caption" Click="OnMinimize" AutomationProperties.Name="Minimize" ToolTip.Tip="Minimize">
        <views:CaptionGlyph Kind="Minimize" />
      </Button>
      <!-- What the window puts before the title (Status): the chat window's server status. Measured
           first, so a long title is cut short before it. -->
      <ContentPresenter x:Name="StatusHost" DockPanel.Dock="Left" />
      <TextBlock x:Name="TitleText" Classes="title" IsHitTestVisible="False" />
    </DockPanel>
    <!-- Windows 10's frame line along the top, over the strip's top row (see TitleBar.FrameLine). -->
    <Border Classes="titleTopLine" IsHitTestVisible="False" />
  </Panel>
</UserControl>
