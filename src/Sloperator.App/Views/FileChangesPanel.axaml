<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sloperator.App.ViewModels"
             xmlns:views="using:Sloperator.App.Views"
             x:Class="Sloperator.App.Views.FileChangesPanel"
             x:DataType="vm:FileChangesViewModel"
             Background="{StaticResource BbBackground}">

  <UserControl.Styles>
    <!-- The diff's rows: no look of a list item's own, but for the line's colour and the pick's. -->
    <Style Selector="ListBox.diff">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    </Style>
    <!-- Wrap: no scrolling sideways, so a line is as wide as the panel and wraps under its code. -->
    <Style Selector="ListBox.diff.wrap">
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="ListBox.diff.wrap TextBlock.code">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- What the agent just changed, while watching: lit up, then it fades. -->
    <Style Selector="Border.fresh">
      <Setter Property="Background" Value="#40FCC21B" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.fresh.on">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ListBox.diff ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="ListBox.diff ListBoxItem /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.diff ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.diff ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.diff ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.diff ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.row.added">
      <Setter Property="Background" Value="{StaticResource BbAddedRow}" />
    </Style>
    <Style Selector="Border.row.removed">
      <Setter Property="Background" Value="{StaticResource BbRemovedRow}" />
    </Style>
    <!-- A file's header: a card's colour. A hunk's divider has no band of its own, only its words.
         (No line over the header: a row's border is only its left side, for the pick, and Avalonia
         draws no box shadow on a border whose sides differ.) -->
    <Style Selector="Border.row.header">
      <Setter Property="Background" Value="{StaticResource BbSurface}" />
      <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
    <Style Selector="ListBox.diff ListBoxItem:pointerover Border.row">
      <Setter Property="BorderBrush" Value="#80FCC21B" />
    </Style>
    <!-- Picked: goes with the next message. -->
    <Style Selector="ListBox.diff ListBoxItem:selected Border.row">
      <Setter Property="Background" Value="{StaticResource BbAccentTint}" />
      <Setter Property="BorderBrush" Value="{StaticResource BbAccent}" />
    </Style>
    <!-- A line's number faint; an added line's green and a removed line's (the old file's) red, as
         their markers. The code a shade under the main text. -->
    <Style Selector="TextBlock.number">
      <Setter Property="Foreground" Value="{StaticResource BbFaint}" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style Selector="Border.row.added TextBlock.number">
      <Setter Property="Foreground" Value="{StaticResource BbAdded}" />
    </Style>
    <Style Selector="Border.row.removed TextBlock.number">
      <Setter Property="Foreground" Value="{StaticResource BbRemoved}" />
    </Style>
    <Style Selector="ListBox.diff TextBlock.code">
      <Setter Property="Foreground" Value="{StaticResource BbCode}" />
    </Style>
    <Style Selector="TextBlock.marker.added">
      <Setter Property="Foreground" Value="{StaticResource BbAdded}" />
    </Style>
    <Style Selector="TextBlock.marker.removed">
      <Setter Property="Foreground" Value="{StaticResource BbRemoved}" />
    </Style>
    <!-- "+10 -3" after a file and in the summary: added lines green, removed red, as the markers. -->
    <Style Selector="Run.addedCount">
      <Setter Property="Foreground" Value="{StaticResource BbAdded}" />
    </Style>
    <Style Selector="Run.removedCount">
      <Setter Property="Foreground" Value="{StaticResource BbRemoved}" />
    </Style>
    <!-- A hunk's divider: small, muted, starting where the numbers do. -->
    <Style Selector="TextBlock.divider">
      <Setter Property="Foreground" Value="{StaticResource BbMuted}" />
      <Setter Property="FontSize" Value="11" />
      <!-- 1 lower than its line, which held it 1 px (at 125%) over its row's middle; as tall. -->
      <Setter Property="Margin" Value="4,1,4,-1" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="ListBox.files">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- One line a file, so a long list fits (the user, 2026-10-29): its name, its counts at the right. -->
    <Style Selector="ListBox.files ListBoxItem">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- A file some of whose lines are picked: grey, selected or not, as only those lines are (the
         user, 2026-10-28); yellow again once they are let go, if it is selected. -->
    <Style Selector="ListBox.files ListBoxItem.lines /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.files ListBoxItem.lines:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.files ListBoxItem.lines:selected /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.files ListBoxItem.lines:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BbChip}" />
    </Style>
    <!-- Stage, Unstage and Discard over the diff: one that has nothing to act on is only greyed, not
         filled: it shouldn't look the more pressable. -->
    <Style Selector="Button.act:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource BbControlBorder}" />
      <Setter Property="Foreground" Value="{StaticResource BbMuted}" />
    </Style>
    <Style Selector="Button.act:disabled">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <!-- A foldout's header in the file list: a flat button as wide as the list, its arrow pointing
         down while open; lit under the pointer as any button is. -->
    <Style Selector="Button.fold">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.fold PathIcon.arrow">
      <Setter Property="Foreground" Value="{StaticResource BbMuted}" />
      <Setter Property="RenderTransform" Value="rotate(-90deg)" />
    </Style>
    <Style Selector="Button.fold.open PathIcon.arrow">
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="TextBlock.added">
      <Setter Property="Foreground" Value="{StaticResource BbAdded}" />
    </Style>
    <Style Selector="TextBlock.deleted">
      <Setter Property="Foreground" Value="{StaticResource BbRemoved}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- How the panel is used, or what went wrong; how many files changed on the right, Wrap and Watch, then
         × to close the panel. A bar as the chat's top bar beside it. -->
    <Border DockPanel.Dock="Top" Classes="bar">
      <DockPanel MinHeight="32">
        <views:ToolkitClose DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
        <ToggleButton DockPanel.Dock="Right" Classes="ghost" IsChecked="{Binding Watch}" IsVisible="{Binding HasFiles}" Margin="8,0,0,0"
                      ToolTip.Tip="Follow the agent's changes as they happen" AutomationProperties.Name="Watch">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Width="14" Height="14" Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" />
            <TextBlock Text="Watch" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton DockPanel.Dock="Right" Classes="ghost" IsChecked="{Binding Wrap}" IsVisible="{Binding HasFiles}" Margin="12,0,0,0"
                      ToolTip.Tip="Wrap long lines" AutomationProperties.Name="Wrap">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Width="14" Height="14" Data="M4 19h6v-2H4v2zM20 5H4v2h16V5zm-3 6H4v2h13.25c1.1 0 2 .9 2 2s-.9 2-2 2H15v-2l-3 3 3 3v-2h2c2.21 0 4-1.79 4-4s-1.79-4-4-4z" />
            <TextBlock Text="Wrap" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <TextBlock DockPanel.Dock="Right" Classes="muted" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip.Tip="{Binding Folder}" AutomationProperties.Name="{Binding Summary}">
          <Run Text="{Binding SummaryFiles}" /><Run Classes="addedCount" Text="{Binding SummaryAdded}" /><Run Classes="removedCount" Text="{Binding SummaryRemoved}" />
        </TextBlock>
        <TextBlock Classes="muted" Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Status}" />
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="230,4,*">
      <!-- The changed files: a click goes to one in the diff, and makes it what a message is about
           with no lines picked; a right-click offers its folder. -->
      <ScrollViewer x:Name="FileLists" Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Sections}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FileSection">
              <StackPanel>
                <!-- A foldout's header: Committed, Staged, Unstaged or Outside git, and how many files. -->
                <Button Classes="flat fold" Classes.open="{Binding IsExpanded}" Command="{Binding ToggleCommand}" IsVisible="{Binding HasHeader}"
                        AutomationProperties.Name="{Binding Name}" ToolTip.Tip="Fold or unfold">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <PathIcon Classes="arrow" Width="10" Height="10" Data="M7 10l5 5 5-5z" />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Count}" Classes="muted" Margin="4,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <ListBox Classes="files" ItemsSource="{Binding Files}" Selection="{Binding Selection}" SelectionMode="Multiple" IsVisible="{Binding IsExpanded}"
                         SelectionChanged="OnFilePicked" ContainerPrepared="OnFileContainer" ContextRequested="OnFileMenu" AutomationProperties.Name="{Binding ListName}"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DiffFileItem">
                      <DockPanel ToolTip.Tip="{Binding Tip}">
                        <TextBlock DockPanel.Dock="Right" Classes="muted" Margin="8,0,0,0" VerticalAlignment="Center">
                          <Run Classes="addedCount" Text="{Binding AddedCount}" /><Run Classes="removedCount" Text="{Binding RemovedCount}" /><Run Text="{Binding OtherCount}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="LeadingCharacterEllipsis" VerticalAlignment="Center"
                                   Classes.added="{Binding IsNew}" Classes.deleted="{Binding IsDeleted}" />
                      </DockPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <Panel Grid.Column="2">
        <TextBlock Classes="muted" IsVisible="{Binding !HasFiles}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"
                   Text="{Binding EmptyText}" />
        <DockPanel IsVisible="{Binding HasFiles}">
          <!-- Stage, Unstage and Discard act on the picked lines, else the selected file; what that is
               shows beside them. Stage and Unstage only where a file is in git. -->
          <Border DockPanel.Dock="Top" Classes="bar" Padding="8">
            <DockPanel>
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
                <Button Classes="ghost small act" Command="{Binding StageCommand}" IsVisible="{Binding ShowGit}" IsEnabled="{Binding CanStage}"
                        ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding StageTip}" AutomationProperties.Name="Stage">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="12" Height="12" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                    <TextBlock Text="Stage" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="ghost small act" Command="{Binding UnstageCommand}" IsVisible="{Binding ShowGit}" IsEnabled="{Binding CanUnstage}"
                        ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding UnstageTip}" AutomationProperties.Name="Unstage">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="12" Height="12" Data="M19 13H5v-2h14v2z" />
                    <TextBlock Text="Unstage" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="ghost small act" Command="{Binding DiscardCommand}" IsEnabled="{Binding CanDiscard}"
                        ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding DiscardTip}" AutomationProperties.Name="Discard">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="12" Height="12" Data="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z" />
                    <TextBlock Text="Discard" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
              <TextBlock Classes="muted" Text="{Binding Target}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding Target}" />
            </DockPanel>
          </Border>
          <!-- Every row of the diff; clicked lines are picked into the chat's box. -->
          <ListBox x:Name="DiffList" Classes="diff" Classes.wrap="{Binding Wrap}" ItemsSource="{Binding Rows}" Selection="{Binding Selection}" SelectionMode="Multiple"
                   AutomationProperties.Name="Diff">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DiffRow">
                <Border Classes="row" Classes.added="{Binding IsAdded}" Classes.removed="{Binding IsRemoved}" Classes.hunk="{Binding IsHunk}" Classes.header="{Binding IsHeader}">
                  <Panel>
                    <Border Classes="fresh" Classes.on="{Binding IsFresh}" />
                    <!-- A long path is cut short at its start, the details kept right after it. A click here picks the whole file. -->
                    <DockPanel Margin="8,5" IsVisible="{Binding IsHeader}" HorizontalAlignment="Left">
                      <TextBlock DockPanel.Dock="Right" Classes="muted" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Run Text="{Binding HeaderStatus}" /><Run Classes="addedCount" Text="{Binding File.AddedCount}" /><Run Classes="removedCount" Text="{Binding File.RemovedCount}" /><Run Text="{Binding File.OtherCount}" />
                      </TextBlock>
                      <TextBlock Text="{Binding Text}" FontWeight="SemiBold" FontSize="13" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding File.FullPath}" />
                    </DockPanel>
                    <!-- One number (the new line's, a removed line's old one greyed out) in a column as wide as the file's
                         widest, the marker right after it; unseen copies of "000" and "+" size both the same on every row.
                         The code's column takes what is left (wrapping); scrolled sideways, as wide as the line. The number
                         and marker stay on a wrapped line's first row. -->
                    <!-- A hunk: a slim divider saying which lines follow ("Lines 96-104"), not git's @@ line, whose numbers
                         the gutter already shows. A click here picks the hunk. -->
                    <TextBlock Classes="divider" IsVisible="{Binding IsHunk}" Text="{Binding Divider}" />
                    <!-- More room over the code than under it (3 px and -1 at 125%, the row as tall as with 1
                         each): Consolas' capitals sit high in its line, and a line's text was 2.5 px over the
                         middle of its row. -->
                    <Grid ColumnDefinitions="Auto,Auto,*" IsVisible="{Binding IsCode}" Margin="0,2.4,0,-0.8" TextElement.FontFamily="Cascadia Mono,Consolas,monospace">
                      <Panel Grid.Column="0" Margin="4,0,0,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding File.NumberSizer}" Opacity="0" />
                        <TextBlock Classes="number" Classes.removed="{Binding IsRemoved}" Text="{Binding Number}" />
                      </Panel>
                      <Panel Grid.Column="1" Margin="0,0,4,0" VerticalAlignment="Top">
                        <TextBlock Text="+" Opacity="0" />
                        <TextBlock Classes="marker" Classes.added="{Binding IsAdded}" Classes.removed="{Binding IsRemoved}" Text="{Binding Marker}" />
                      </Panel>
                      <TextBlock Grid.Column="2" Classes="code" Text="{Binding Text}" Margin="0,0,16,0" />
                    </Grid>
                  </Panel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Panel>
    </Grid>
  </DockPanel>
</UserControl>
