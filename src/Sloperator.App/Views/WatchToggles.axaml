<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sloperator.App.ViewModels"
             x:Class="Sloperator.App.Views.WatchToggles"
             x:DataType="vm:IWatchPanel">
  <!-- Wrap and Watch in the top bar of a panel that follows the agent's edits (File changes, Code editor):
       one control for both panels, so they look and sit the same, 8 apart. There from the start, with no
       files too (the user, 2026-10-31), so the bar doesn't change mid-task when the first file does. -->
  <StackPanel Orientation="Horizontal" Spacing="8">
    <ToggleButton Classes="ghost" IsChecked="{Binding Wrap}" ToolTip.Tip="Wrap long lines" AutomationProperties.Name="Wrap">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <PathIcon Width="14" Height="14" Data="M4 19h6v-2H4v2zM20 5H4v2h16V5zm-3 6H4v2h13.25c1.1 0 2 .9 2 2s-.9 2-2 2H15v-2l-3 3 3 3v-2h2c2.21 0 4-1.79 4-4s-1.79-4-4-4z" />
        <TextBlock Text="Wrap" VerticalAlignment="Center" />
      </StackPanel>
    </ToggleButton>
    <ToggleButton Classes="ghost" IsChecked="{Binding Watch}" ToolTip.Tip="Follow the agent's changes as they happen" AutomationProperties.Name="Watch">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <PathIcon Width="14" Height="14" Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" />
        <TextBlock Text="Watch" VerticalAlignment="Center" />
      </StackPanel>
    </ToggleButton>
  </StackPanel>
</UserControl>
