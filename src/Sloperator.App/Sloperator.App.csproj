<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows builds include the Windows desktop backend; other OSes build the portable core only. -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Sloperator</AssemblyName>
    <RootNamespace>Sloperator.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\sloperator.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The published exe is trimmed: flag code that needs reflection while it is written. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <!-- Builds carry their own .NET, so bin\...\Sloperator.exe also runs on a PC without .NET
       installed. The output path stays without the runtime folder the SDK would add. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- ANGLE (Direct3D under OpenGL ES) isn't used: the app draws with WGL (see Program). Its library,
       which Avalonia.Desktop brings along, stays out of what is published. -->
  <Target Name="LeaveOutAngle" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'av_libglesv2.dll'" />
    </ItemGroup>
  </Target>

  <!-- Single-file builds: publish.ps1 passes the native libraries, a zip packed with Brotli
       (pack-runtime.cs), which PortableRuntime unpacks into Data/runtime on first run. -->
  <ItemGroup Condition="'$(RuntimePayload)' != ''">
    <EmbeddedResource Include="$(RuntimePayload)" LogicalName="Sloperator.runtime.br" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sloperator.Core\Sloperator.Core.csproj" />
    <ProjectReference Include="..\Sloperator.Platform.Windows\Sloperator.Platform.Windows.csproj" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

</Project>
