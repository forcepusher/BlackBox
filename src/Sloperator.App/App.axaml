<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Sloperator.App.Views"
             x:Class="Sloperator.App.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <SolidColorBrush x:Key="BbBackground" Color="#111214" />
    <SolidColorBrush x:Key="BbSurface" Color="#1A1C1F" />
    <SolidColorBrush x:Key="BbSurfaceRaised" Color="#23262A" />
    <SolidColorBrush x:Key="BbBorder" Color="#2F3338" />
    <SolidColorBrush x:Key="BbMuted" Color="#8B9199" />
    <!-- The yellow of the blob logo (docs/logo/blob.svg); lighter under the pointer, darker pressed.
         Dark text (#111214) on it reads at about 12:1. -->
    <SolidColorBrush x:Key="BbAccent" Color="#FCC21B" />
    <SolidColorBrush x:Key="BbAccentHover" Color="#FDD45F" />
    <SolidColorBrush x:Key="BbAccentPressed" Color="#DEAB18" />
    <!-- Fluent puts white on its accent, which is lost on the yellow: a ticked box's tick is dark
         instead (a pressed-in toggle's too, in the styles below). -->
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#111214" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#111214" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#111214" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#111214" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#111214" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#111214" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#111214" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="#111214" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="#111214" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#111214" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#111214" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#111214" />
    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#111214" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#111214" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#111214" />
    <!-- A picked row in a list or dropdown: Fluent lays the yellow at 60% under white text (and the
         file list's green and red names), which reads at under 4:1. A dark tint of it instead, under
         the row's own text, as the diff's picked lines have. -->
    <SolidColorBrush x:Key="BbAccentTint" Color="#5A765B0D" />
    <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#5A765B0D" />
    <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#78765B0D" />
    <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#96765B0D" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#5A765B0D" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#78765B0D" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#96765B0D" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#5A765B0D" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#78765B0D" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="#96765B0D" />
    <!-- Fluent's paddings put more room under the text than over it, for Segoe UI, whose capitals sit
         low in their line. Inter's sit in its middle (ascent 0.969 em, descent 0.242, capitals 0.727),
         so with those paddings every dropdown's text was 2 px (at 125%) over its middle, a button's 1:
         the same room over and under it instead (the user, 2026-10-29). -->
    <Thickness x:Key="ComboBoxPadding">12,6,0,6</Thickness>
    <SolidColorBrush x:Key="BbUserBubble" Color="#2A2F36" />
    <SolidColorBrush x:Key="BbOk" Color="#5FB878" />
    <SolidColorBrush x:Key="BbError" Color="#E06C6C" />
    <SolidColorBrush x:Key="BbErrorHover" Color="#E88787" />
    <SolidColorBrush x:Key="BbErrorPressed" Color="#C75E5E" />
  </Application.Resources>

  <Application.Styles>
    <!-- Fluent's own accent (sliders, check boxes, toggles) is the same yellow, not the Windows one. -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#FCC21B" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource BbBackground}" />
    </Style>

    <!-- One size for every button, dropdown and text box: 32 high, as Fluent's text boxes and
         dropdowns are; a small button (in a card, under a preview, in a player, over the diff) 24.
         Room between things goes in steps of 4, whole pixels at 100, 125, 150 and 175%. -->
    <!-- Every button's content in its middle. Fluent sizes a button by its padding (5 over, 6 under,
         for Segoe UI) and lays the content at its top, so a button made taller had its word high:
         Send's was 1.5 px over its middle at 125%. In the middle, Inter's capitals are, at any
         height (see ComboBoxPadding). First, so a class's own size further on wins; only the app's
         own toggles, not the ones in Fluent's templates (an Expander's header). -->
    <Style Selector="Button, ToggleButton.ghost">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.small, ToggleButton.small">
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <!-- Only an icon: square, the icon in its middle. -->
    <Style Selector="Button.icon, ToggleButton.icon">
      <Setter Property="Width" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon.small, ToggleButton.icon.small">
      <Setter Property="Width" Value="24" />
    </Style>
    <!-- A dropdown's rows, and a menu's: the same room over and under them too (Fluent's is 5 over,
         7 under for a dropdown, 4 and 7 for a menu), so a menu's rows are as tall as a dropdown's. -->
    <Style Selector="ComboBoxItem, MenuItem">
      <Setter Property="Padding" Value="11,6" />
    </Style>

    <Style Selector="TextBlock.muted, SelectableTextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource BbMuted}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.muted.error, SelectableTextBlock.muted.error">
      <Setter Property="Foreground" Value="{StaticResource BbError}" />
    </Style>
    <!-- What a field is, left of it: in the chat's top rows, Settings and Video generator's bar. -->
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{StaticResource BbMuted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Without a background a text block is hit only on its glyphs, so a drag had to start exactly
         on a letter; transparent, its whole box (line gaps, the space after a short line) starts one. -->
    <Style Selector="SelectableTextBlock">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- Selected text sits on the yellow, so it turns dark there, as on a button; Fluent leaves it
         light (about 1.6:1). -->
    <Style Selector="SelectableTextBlock">
      <Setter Property="SelectionForegroundBrush" Value="#111214" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="SelectionForegroundBrush" Value="#111214" />
    </Style>

    <!-- A fenced code block in a reply (MarkdownView): its language and Copy over the code. -->
    <Style Selector="Border.code">
      <Setter Property="Background" Value="{StaticResource BbSurface}" />
      <Setter Property="BorderBrush" Value="{StaticResource BbBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <!-- A table in a reply (MarkdownTable): a grid on the code blocks' surface, its header row raised. -->
    <Style Selector="Border.mdTable">
      <Setter Property="Background" Value="{StaticResource BbSurface}" />
      <Setter Property="BorderBrush" Value="{StaticResource BbBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <!-- A reply's quotes (MarkdownParts): a bar beside each level, the text muted; and a rule across. -->
    <Style Selector="Border.mdQuote">
      <Setter Property="BorderBrush" Value="{StaticResource BbBorder}" />
      <Setter Property="BorderThickness" Value="4,0,0,0" />
      <Setter Property="Padding" Value="12,0,0,0" />
    </Style>
    <Style Selector="Border.mdRule">
      <Setter Property="Background" Value="{StaticResource BbBorder}" />
    </Style>
    <Style Selector="Border.mdBox">
      <Setter Property="BorderBrush" Value="{StaticResource BbMuted}" />
    </Style>
    <Style Selector="Border.mdTicked">
      <Setter Property="BorderBrush" Value="{StaticResource BbAccent}" />
      <Setter Property="Background" Value="{StaticResource BbAccent}" />
    </Style>
    <Style Selector="TextBlock.mdMuted, SelectableTextBlock.mdMuted">
      <Setter Property="Foreground" Value="{StaticResource BbMuted}" />
    </Style>
    <Style Selector="DockPanel.codeHeader">
      <Setter Property="Margin" Value="12,4,4,0" />
    </Style>
    <!-- The code sits 12,2,12,10 inside the box as before; its text block reaches 11 past the box's
         sides and 3 under it (over the 1px border), so a drag from there selects. Whole multiples of 4
         are whole pixels at every usual scale, so the box rounds to the same size as without them. -->
    <Style Selector="SelectableTextBlock.code">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="19" />
      <Setter Property="Margin" Value="-12,0,-12,-4" />
      <Setter Property="Padding" Value="24,2,24,14" />
    </Style>
    <!-- The command on a run_shell card, open under its title: a well as dark as the Output under it,
         its text in line with Output's. The text block reaches the box's edges, so a drag from its
         padding selects. -->
    <Style Selector="Border.command">
      <Setter Property="Background" Value="{StaticResource BbBackground}" />
      <Setter Property="BorderBrush" Value="{StaticResource BbBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="SelectableTextBlock.command">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LineHeight" Value="16" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
    <!-- Copy on a code block: a small flat button, its word as quiet as the language beside it. -->
    <Style Selector="Button.copyCode">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource BbMuted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="24" />
    </Style>

    <!-- The server dot in the top bar: grey until checked, then yellow, green or red. -->
    <Style Selector="Ellipse.status">
      <Setter Property="Fill" Value="{StaticResource BbMuted}" />
    </Style>
    <Style Selector="Ellipse.status.checking">
      <Setter Property="Fill" Value="{StaticResource BbAccent}" />
    </Style>
    <Style Selector="Ellipse.status.connected">
      <Setter Property="Fill" Value="{StaticResource BbOk}" />
    </Style>
    <Style Selector="Ellipse.status.failed">
      <Setter Property="Fill" Value="{StaticResource BbError}" />
    </Style>

    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,12,0,4" />
    </Style>

    <!-- The bar along the top of the chat and of each side panel, and along the foot of Settings:
         the surface, a line on its inner side, 16 in from the window's edge, its buttons and
         dropdowns 8 from its edges, so every such bar is 49 high and those side by side line up. -->
    <Style Selector="Border.bar">
      <Setter Property="Background" Value="{StaticResource BbSurface}" />
      <Setter Property="BorderBrush" Value="{StaticResource BbBorder}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style Selector="Border.bar.foot">
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <!-- The line between the chat and a side panel, and between File changes' list and its diff. -->
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="{StaticResource BbBorder}" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource BbAccent}" />
      <Setter Property="Foreground" Value="#111214" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- A button on the accent (primary, or accent for a round play button) stays on it under the
         pointer and pressed instead of going to Fluent's grey. -->
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter, Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BbAccentHover}" />
      <Setter Property="Foreground" Value="#111214" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter, Button.accent:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BbAccentPressed}" />
      <Setter Property="Foreground" Value="#111214" />
    </Style>
    <!-- Stop: red, and stays red under the pointer and pressed, lighter and darker as the yellow ones
         do (Fluent's grey took its colour away under the pointer). -->
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{StaticResource BbError}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BbErrorHover}" />
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BbErrorPressed}" />
    </Style>

    <!-- The app's usual button: its border on no fill; under the pointer and pressed it fills as
         Fluent's buttons do. -->
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource BbBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- No border either, where it sits in a box of its own (the paperclip, a list's foldout, Copy). -->
    <Style Selector="Button.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- No look of a button's own, in any state: a picture, a card or a clip on the timeline that a
         click opens or picks. -->
    <Style Selector="Button.bare">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.bare /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- A ghost button that opens a list (History, the video's name): the arrow 10 from its right
         edge, 12 from the word, as on the Side panel dropdown beside it; pressed, it doesn't shrink,
         as no dropdown does. -->
    <Style Selector="Button.menu">
      <Setter Property="Padding" Value="8,0,0,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.menu:pressed, Button.dropdown:pressed">
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Button.menu PathIcon.arrow, Button.dropdown PathIcon.arrow">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Margin" Value="12,0,9,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Data" Value="M7 10l5 5 5-5z" />
    </Style>
    <!-- A button that opens a list beside the top bar's dropdowns (Servers): drawn as they are, its
         word at their padding and the arrow 10 from the right; a ghost button there looked out of
         place (the user, 2026-10-29). Hovered and pressed it changes as they do: their fill and border,
         the text staying light (Fluent has no ComboBoxForegroundPointerOver, and a missing brush made
         it black) and no shrinking, which a button does pressed. -->
    <Style Selector="Button.dropdown">
      <Setter Property="Background" Value="{DynamicResource ComboBoxBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxBorderBrush}" />
      <Setter Property="BorderThickness" Value="{DynamicResource ComboBoxBorderThemeThickness}" />
      <Setter Property="Padding" Value="12,0,0,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.dropdown:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ComboBoxBackgroundPointerOver}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxBorderBrushPointerOver}" />
      <Setter Property="Foreground" Value="{DynamicResource ComboBoxForeground}" />
    </Style>
    <Style Selector="Button.dropdown:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ComboBoxBackgroundPressed}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxBorderBrushPressed}" />
      <Setter Property="Foreground" Value="{DynamicResource ComboBoxForeground}" />
    </Style>
    <Style Selector="Button.dropdown PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource ComboBoxDropDownGlyphForeground}" />
    </Style>
    <!-- The Side panel dropdown in the top bar: drawn as the ghost buttons beside it (History, New
         chat), its word where theirs is, not as a field; under the pointer and pressed it fills as
         they do (a dropdown darkens, and it went dark beside History lighting up). -->
    <Style Selector="ComboBox.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource BbBorder}" />
      <Setter Property="Padding" Value="8,0,0,0" />
    </Style>
    <Style Selector="ComboBox.ghost:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrushPointerOver}" />
    </Style>
    <Style Selector="ComboBox.ghost:pressed /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPressed}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrushPressed}" />
    </Style>
    <!-- Only the app's own toggles (Wrap, Watch, Area, Show), which go yellow pressed in: an Expander's
         header is a ToggleButton too, checked while open, on the dark surface. -->
    <Style Selector="ToggleButton.ghost:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="#111214" />
    </Style>
    <Style Selector="ToggleButton.ghost:checked PathIcon">
      <Setter Property="Foreground" Value="#111214" />
    </Style>

    <!-- Every dropdown's arrow is the solid triangle History has (the user, 2026-10-24: "Arrows
         need consistency"), not Fluent's thin chevron. Set in its template, the chevron is taken
         over only by a style that depends on a state, as these two together. -->
    <Style Selector="ComboBox:not(:disabled) /template/ PathIcon#DropDownGlyph, ComboBox:disabled /template/ PathIcon#DropDownGlyph">
      <Setter Property="Data" Value="M7 10l5 5 5-5z" />
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
    </Style>
    <!-- A dropdown's list hangs from its left edge. Fluent centres it under the box, so a list wider
         than the box (a model's long name) stuck out on the left (the user, 2026-10-29). Taken over
         from the template as the arrow is, by a style that depends on a state. Every list opened by a
         click hangs this way (Views/Dropdown.cs). -->
    <Style Selector="ComboBox:not(:disabled) /template/ Popup#PART_Popup, ComboBox:disabled /template/ Popup#PART_Popup">
      <Setter Property="Placement" Value="{x:Static views:Dropdown.Placement}" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource BbSurface}" />
      <Setter Property="BorderBrush" Value="{StaticResource BbBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
    </Style>

    <!-- Fluent gives an Expander a 48px minimum height and applies it to the body as well as
         the header, so a one-line body (short Thoughts) sat on an empty band. Without it the
         header is as tall as its chevron button and the body hugs its text. -->
    <Style Selector="Expander">
      <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- History's and Servers' lists, drawn as a dropdown's list (they were a bordered list on the
         panel's colour, with rounded rows lit grey, beside dropdowns of Fluent's: the user,
         2026-10-29): its surface, border and corners, 4 over and under the rows. A row is a
         dropdown's row too: as far in, lit as one under the pointer and pressed, and the chat or
         server in use picked as a dropdown's pick is; its trash button turns red under the pointer. -->
    <Style Selector="FlyoutPresenter.list">
      <Setter Property="Background" Value="{DynamicResource ComboBoxDropDownBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxDropDownBorderBrush}" />
      <Setter Property="BorderThickness" Value="{DynamicResource ComboBoxDropdownBorderThickness}" />
      <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
      <Setter Property="Padding" Value="{DynamicResource ComboBoxDropdownContentMargin}" />
      <Setter Property="MaxHeight" Value="440" />
    </Style>
    <Style Selector="Border.listRow">
      <Setter Property="Background" Value="{DynamicResource ComboBoxItemBackground}" />
    </Style>
    <Style Selector="Border.listRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource ComboBoxItemBackgroundPointerOver}" />
    </Style>
    <Style Selector="Border.listRow.current">
      <Setter Property="Background" Value="{DynamicResource ComboBoxItemBackgroundSelected}" />
    </Style>
    <Style Selector="Border.listRow.current:pointerover">
      <Setter Property="Background" Value="{DynamicResource ComboBoxItemBackgroundSelectedPointerOver}" />
    </Style>
    <Style Selector="Button.listRow">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="11,6,40,6" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.listRow /template/ ContentPresenter, Button.rowDelete /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.listRow:pressed">
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Button.listRow:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ComboBoxItemBackgroundPressed}" />
    </Style>
    <!-- The icon sits as far in from the row's right edge as the title does from its left. -->
    <Style Selector="Button.rowDelete">
      <Setter Property="Margin" Value="0,0,7,0" />
    </Style>
    <Style Selector="Button.rowDelete PathIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Foreground" Value="{StaticResource BbMuted}" />
    </Style>
    <Style Selector="Button.rowDelete:pointerover PathIcon">
      <Setter Property="Foreground" Value="{StaticResource BbError}" />
    </Style>

    <!-- The message box: the card around it is the visible field, so the TextBox itself stays
         flat in every state and the card's border shows focus instead. -->
    <Style Selector="Border.composer:focus-within">
      <Setter Property="BorderBrush" Value="{StaticResource BbAccent}" />
    </Style>
    <Style Selector="TextBox.composer /template/ Border#PART_BorderElement,
                     TextBox.composer:pointerover /template/ Border#PART_BorderElement,
                     TextBox.composer:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

  </Application.Styles>
</Application>
