<Project Sdk="Microsoft.NET.Sdk">

  <!-- The chat lab for scripts/chat-test.ps1: local look-alikes of a messenger, a social network,
       a shop's support chat and a marketplace, with scripted people on the other side, so Sloperator
       can be tested standing in for the user in chats without anyone real being messaged. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Sloperator.ChatLab</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
