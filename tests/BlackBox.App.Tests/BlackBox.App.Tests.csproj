<Project Sdk="Microsoft.NET.Sdk">

  <!-- The window's own markup laid out without a screen (Avalonia's headless platform, drawing with
       Skia so text is measured with the real fonts). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- The app is a self-contained exe; the tests only load its assembly. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlackBox.App\BlackBox.App.csproj" />
  </ItemGroup>

  <!-- Replies as models write them, laid out by MarkdownLayoutTests. -->
  <ItemGroup>
    <None Include="Replies\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
