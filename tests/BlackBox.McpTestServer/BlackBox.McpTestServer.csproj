<Project Sdk="Microsoft.NET.Sdk">

  <!-- A small MCP server for the tests: in-process over streams, and as a real child process
       over stdio (the tests start it with "dotnet BlackBox.McpTestServer.dll"). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>BlackBox.McpTestServer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
  </ItemGroup>

</Project>
