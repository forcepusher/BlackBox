<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- The release CHANGELOG.md names last; raised with each release. -->
    <Version>1.0.0</Version>
    <!-- English only: keeps the portable folder free of a dozen satellite-resource folders. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Authors>BlackBox contributors</Authors>
  </PropertyGroup>
</Project>
